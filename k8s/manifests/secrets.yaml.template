# TEMPLATE file for Kubernetes secrets
# DO NOT commit actual secrets to version control
# Use kubectl create secret or sealed-secrets in production
#
# To create secrets from this template:
# kubectl create secret generic blockd-secrets \
#   --from-literal=postgres_user=<value> \
#   --from-literal=postgres_password=<value> \
#   --from-literal=redis_password=<value> \
#   --from-literal=rabbitmq_user=<value> \
#   --from-literal=rabbitmq_password=<value> \
#   --from-literal=rabbitmq_erlang_cookie=<value> \
#   --from-literal=jwt_secret=<value> \
#   --from-literal=database_url=<value> \
#   --from-literal=redis_url=<value> \
#   --from-literal=rabbitmq_url=<value> \
#   --from-literal=openai_api_key=<value> \
#   --from-literal=anthropic_api_key=<value> \
#   --from-literal=aws_access_key_id=<value> \
#   --from-literal=aws_secret_access_key=<value> \
#   -n blockd

apiVersion: v1
kind: Secret
metadata:
  name: blockd-secrets
  namespace: blockd
  labels:
    app: blockd
type: Opaque
data:
  # All values must be base64 encoded
  # Example: echo -n "your-secret" | base64

  # Database credentials
  postgres_user: <BASE64_ENCODED_SECRET_HERE>
  postgres_password: <BASE64_ENCODED_SECRET_HERE>

  # Redis credentials
  redis_password: <BASE64_ENCODED_SECRET_HERE>

  # RabbitMQ credentials
  rabbitmq_user: <BASE64_ENCODED_SECRET_HERE>
  rabbitmq_password: <BASE64_ENCODED_SECRET_HERE>
  rabbitmq_erlang_cookie: <BASE64_ENCODED_SECRET_HERE>

  # JWT secret
  jwt_secret: <BASE64_ENCODED_SECRET_HERE>

  # Connection URLs (base64 encoded)
  database_url: <BASE64_ENCODED_SECRET_HERE>
  redis_url: <BASE64_ENCODED_SECRET_HERE>
  rabbitmq_url: <BASE64_ENCODED_SECRET_HERE>

  # API Keys
  openai_api_key: <BASE64_ENCODED_SECRET_HERE>
  anthropic_api_key: <BASE64_ENCODED_SECRET_HERE>

  # AWS credentials
  aws_access_key_id: <BASE64_ENCODED_SECRET_HERE>
  aws_secret_access_key: <BASE64_ENCODED_SECRET_HERE>

  # Internal service token for worker-to-service communication
  internal_service_token: <BASE64_ENCODED_SECRET_HERE>
