# Blockd Interviewee App Environment Configuration

# Backend API URL (API Gateway)
BLOCKD_API_URL=http://localhost:3000

# WebSocket Service URL
BLOCKD_WS_URL=http://localhost:3003

# Video Service URL (for WebRTC streaming)
BLOCKD_VIDEO_URL=http://localhost:8003

# Development mode (enables DevTools, relaxed CSP)
NODE_ENV=development
