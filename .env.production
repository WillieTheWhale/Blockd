# ═══════════════════════════════════════════════════════════════════════════
# BLOCKD PLATFORM - PRODUCTION ENVIRONMENT CONFIGURATION
# Domain: blockd.site
# ═══════════════════════════════════════════════════════════════════════════

# ============================================
# Database Configuration
# ============================================
POSTGRES_DB=blockd
POSTGRES_USER=blockd_admin
POSTGRES_PASSWORD=                    # (REQUIRED) Use AWS Secrets Manager in production

# ============================================
# Redis Configuration
# ============================================
REDIS_HOST=redis.blockd.site          # ElastiCache endpoint
REDIS_PORT=6379
REDIS_PASSWORD=                       # (REQUIRED) Use AWS Secrets Manager
REDIS_DB=0

# ============================================
# RabbitMQ Configuration
# ============================================
RABBITMQ_HOST=rabbitmq.blockd.site    # Amazon MQ endpoint
RABBITMQ_USER=blockd_mq
RABBITMQ_PASSWORD=                    # (REQUIRED) Use AWS Secrets Manager
RABBITMQ_VHOST=blockd

# ============================================
# MinIO/S3 Configuration
# ============================================
S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
S3_BUCKET=blockd-production-videos
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=                    # Use IAM roles in EKS (recommended)
AWS_SECRET_ACCESS_KEY=                # Use IAM roles in EKS (recommended)

# ============================================
# Authentication & Security
# ============================================
JWT_SECRET=                           # (REQUIRED) Use AWS Secrets Manager
JWT_EXPIRY=1h
REFRESH_TOKEN_EXPIRY=7d
MFA_ENCRYPTION_KEY=                   # (REQUIRED) Use AWS Secrets Manager

# ============================================
# AI/ML API Keys
# ============================================
OPENAI_API_KEY=                       # (REQUIRED) Use AWS Secrets Manager
ANTHROPIC_API_KEY=                    # (REQUIRED) Use AWS Secrets Manager
GOOGLE_AI_API_KEY=                    # (REQUIRED) Use AWS Secrets Manager

# ============================================
# Application Settings
# ============================================
NODE_ENV=production
LOG_LEVEL=info

# ============================================
# Frontend URLs (Production)
# ============================================
VITE_API_URL=https://api.blockd.site/api/v1
VITE_WS_URL=wss://ws.blockd.site

# ============================================
# CORS Configuration
# ============================================
CORS_ORIGINS=https://blockd.site,https://www.blockd.site,https://app.blockd.site

# ============================================
# Email Configuration (AWS SES)
# ============================================
EMAIL_ENABLED=true
EMAIL_FROM=noreply@blockd.site
SES_REGION=us-east-1

# ============================================
# Mediasoup WebRTC Configuration
# ============================================
MEDIASOUP_LISTEN_IP=0.0.0.0
MEDIASOUP_ANNOUNCED_IP=               # Set to public IP or load balancer IP
MEDIASOUP_MIN_PORT=10000
MEDIASOUP_MAX_PORT=10100

# ============================================
# Security Headers
# ============================================
ENABLE_HSTS=true
ENABLE_CORS=true
ENABLE_CSRF=true
