{
  "project": "Blockd Platform v1.0",
  "version": "1.0.0",
  "created": "2025-11-24",
  "total_agents": 20,
  "execution_strategy": "phased_parallel",
  "phases": [
    {
      "phase": 1,
      "name": "Infrastructure & Database Foundation",
      "agents": [1, 2, 3, 4],
      "description": "Setup core infrastructure, databases, and foundational services"
    },
    {
      "phase": 2,
      "name": "Core Backend Services",
      "agents": [5, 6, 7, 8],
      "description": "Build API gateway, authentication, session management, and WebSocket infrastructure"
    },
    {
      "phase": 3,
      "name": "AI/ML Services",
      "agents": [9, 10, 11, 12],
      "description": "Implement AI detection, eye tracking, response timing, and video processing"
    },
    {
      "phase": 4,
      "name": "Frontend Application",
      "agents": [13, 14, 15],
      "description": "Build React interviewer application with real-time features"
    },
    {
      "phase": 5,
      "name": "Chromium Browser Architecture",
      "agents": [16, 17, 18],
      "description": "Design and specify Chromium browser modifications and integration"
    },
    {
      "phase": 6,
      "name": "Integration, Testing & Deployment",
      "agents": [19, 20],
      "description": "End-to-end integration, testing, and deployment automation"
    }
  ],
  "agents": [
    {
      "agent_id": 1,
      "name": "Database Architect",
      "phase": 1,
      "priority": "critical",
      "technologies": ["PostgreSQL 16", "TimescaleDB", "pgvector", "Alembic"],
      "responsibilities": [
        "Create complete PostgreSQL database schema",
        "Setup TimescaleDB hypertables for time-series data",
        "Install and configure pgvector extension",
        "Create Alembic migration files",
        "Setup database connection pooling configuration",
        "Create database initialization scripts"
      ],
      "deliverables": [
        "/database/schema.sql",
        "/database/migrations/",
        "/database/seeds/",
        "/database/init.sh",
        "/docs/database-schema.json"
      ],
      "dependencies": [],
      "interfaces": {
        "outputs": {
          "connection_string": "postgresql://user:pass@localhost:5432/blockd",
          "schema_version": "1.0.0",
          "tables": ["users", "organizations", "interview_sessions", "security_events", "gaze_events", "ai_answer_cache"]
        }
      },
      "testing": [
        "Test database migrations up/down",
        "Verify TimescaleDB hypertables",
        "Test pgvector similarity queries",
        "Load test with 10k+ records"
      ]
    },
    {
      "agent_id": 2,
      "name": "Redis & Cache Infrastructure",
      "phase": 1,
      "priority": "critical",
      "technologies": ["Redis 7", "Docker", "redis-py", "ioredis"],
      "responsibilities": [
        "Setup Redis cluster configuration",
        "Design caching strategies for AI answers, sessions, rate limiting",
        "Create Redis connection utilities",
        "Implement cache invalidation logic",
        "Setup Redis Docker configuration"
      ],
      "deliverables": [
        "/infrastructure/redis/redis.conf",
        "/infrastructure/redis/docker-compose.yml",
        "/backend/shared/cache/redis-client.ts",
        "/backend/shared/cache/redis-client.py",
        "/docs/caching-strategy.json"
      ],
      "dependencies": [],
      "interfaces": {
        "outputs": {
          "redis_url": "redis://localhost:6379",
          "cache_keys": {
            "session": "session:{session_id}",
            "ai_answer": "ai_answer:{question_hash}:{model}",
            "rate_limit": "rate_limit:{ip}:{endpoint}"
          }
        }
      },
      "testing": [
        "Test cache set/get operations",
        "Test TTL expiration",
        "Test rate limiting logic",
        "Performance test: 10k ops/sec"
      ]
    },
    {
      "agent_id": 3,
      "name": "Message Queue & Event Streaming",
      "phase": 1,
      "priority": "high",
      "technologies": ["RabbitMQ", "Celery", "Docker"],
      "responsibilities": [
        "Setup RabbitMQ cluster",
        "Design message queue topology (exchanges, queues, routing)",
        "Create Celery workers configuration",
        "Implement event publishing/consuming utilities",
        "Setup dead letter queues for failed messages"
