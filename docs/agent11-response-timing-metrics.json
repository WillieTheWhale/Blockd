        "Generate report -> comprehensive timing analysis",
        "Flag anomalies -> review suspicious patterns"
      ]
    },
    "historical_analysis": {
      "description": "Analyze past interviews for patterns",
      "workflow": [
        "Query historical data -> retrieve audio files",
        "Re-analyze with updated models -> improved detection",
        "Trend analysis -> identify cheating patterns",
        "Model refinement -> improve detection accuracy"
      ]
    }
  },
  "integration_examples": {
    "python_client": {
      "language": "Python",
      "code": "async def analyze_answer(question_id, audio_url, timestamps, difficulty):\n    async with httpx.AsyncClient() as client:\n        response = await client.post(\n            'http://localhost:8006/api/v1/timing/analyze',\n            json={\n                'question_id': question_id,\n                'audio_url': audio_url,\n                'question_asked_at': timestamps['asked'],\n                'answer_start_timestamp': timestamps['started'],\n                'difficulty': difficulty\n            },\n            timeout=120.0\n        )\n        return response.json()"
    },
    "javascript_client": {
      "language": "JavaScript",
      "code": "async function analyzeAnswer(questionId, audioUrl, timestamps, difficulty) {\n  const response = await fetch('http://localhost:8006/api/v1/timing/analyze', {\n    method: 'POST',\n    headers: { 'Content-Type': 'application/json' },\n    body: JSON.stringify({\n      question_id: questionId,\n      audio_url: audioUrl,\n      question_asked_at: timestamps.asked,\n      answer_start_timestamp: timestamps.started,\n      difficulty: difficulty\n    })\n  });\n  return await response.json();\n}"
    }
  },
