{
  "service": {
    "name": "Response Timing Service",
    "agent": "Agent 11: Response Timing Service Developer",
    "version": "1.0.0",
    "created_at": "2025-11-24",
    "description": "Production-grade response timing analysis service using OpenAI Whisper for speech-to-text, analyzing speech rate, pause frequency, filler words, and detecting timing anomalies",
    "port": 8006,
    "base_url": "/api/v1/timing"
  },
  "technology_stack": {
    "language": "Python 3.14.0",
    "framework": "FastAPI 0.121.3",
    "transcription": {
      "primary": "OpenAI Whisper API",
      "alternative": "Self-hosted Whisper (openai-whisper)",
      "models": ["whisper-1", "tiny", "base", "small", "medium", "large"]
    },
    "audio_processing": {
      "librosa": "0.10.2",
      "pydub": "0.25.1",
      "soundfile": "0.12.1",
      "ffmpeg": "required"
    },
    "statistical_analysis": {
      "numpy": "1.26.4",
      "scipy": "1.14.1",
      "scikit-learn": "1.6.1"
    },
    "storage": {
      "database": "PostgreSQL 18.1",
      "cache": "Redis (optional)",
      "audio_storage": "S3-compatible (MinIO, AWS S3)"
    },
    "message_queue": "RabbitMQ (pika 1.3.2)"
  },
  "core_features": {
    "transcription": {
      "description": "Speech-to-text conversion with word-level timestamps",
      "modes": ["api", "local"],
      "output": {
        "text": "Full transcription text",
        "words": "Array of {word, start, end, confidence}",
        "duration": "Audio duration in seconds",
        "language": "Detected language",
        "confidence": "Overall transcription confidence (0-1)"
      }
    },
    "response_latency": {
      "description": "Time from question asked to answer start",
      "unit": "milliseconds",
      "calculation": "(answer_start_timestamp - question_asked_at) * 1000",
      "baselines": {
        "simple": 3000,
        "analytical": 8000,
        "complex": 15000
      }
    },
    "speech_rate": {
      "description": "Words per minute (WPM) calculation",
      "unit": "words per minute",
      "calculation": "(word_count / speech_duration_seconds) * 60",
      "excludes_fillers": true,
      "classifications": {
        "very_slow": "<80 WPM",
        "slow": "80-120 WPM",
        "normal": "120-160 WPM",
        "fast": "160-200 WPM",
        "very_fast": ">200 WPM (likely reading)"
      }
    },
    "pause_detection": {
      "description": "Energy-based silence detection and analysis",
      "method": "RMS energy with dB threshold",
      "parameters": {
        "threshold_db": -40.0,
        "min_silence_duration": 0.5,
        "frame_length": 2048,
        "hop_length": 512
      },
      "output": {
        "pause_count": "Number of pauses detected",
        "total_pause_time": "Total silence duration",
        "avg_pause_duration": "Average pause length",
        "pause_percentage": "% of total time in pauses",
        "pause_frequency": "Pauses per minute"
      }
    },
    "filler_detection": {
      "description": "Detection of hesitation markers and filler words",
      "filler_words": [
        "um", "uh", "er", "ah",
        "like", "you know", "i mean", "basically",
        "actually", "literally", "kind of", "sort of",
        "right", "okay", "well", "so",
        "hmm", "uhh", "umm", "yeah"
      ],
      "output": {
        "filler_count": "Number of filler words",
        "filler_ratio": "Ratio of fillers to total words (0-1)",
        "filler_instances": "Array of {word, timestamp, position}",
        "filler_types": "Count by filler type"
      },
      "expected_ratios": {
        "natural_speech": "0.02-0.08 (2-8%)",
        "nervous_thinking": "0.08-0.15 (8-15%)",
        "ai_generated_read": "0.00-0.01 (<1%)"
      }
    },
    "timing_patterns": {
      "description": "Statistical analysis of timing consistency",
      "metrics": {
        "word_duration_mean": "Average word duration",
        "word_duration_std": "Word duration standard deviation",
        "pause_duration_mean": "Average pause duration",
        "pause_duration_std": "Pause duration standard deviation",
        "consistency_score": "0-1, higher = more consistent (less natural)"
      }
    }
  },
  "anomaly_detection": {
    "description": "Detection of suspicious timing patterns indicating potential cheating",
    "anomaly_types": {
      "instant_response": {
        "description": "Suspiciously fast response to complex questions",
        "detection": "Response latency < 50% of expected for difficulty level",
        "examples": {
          "complex_question_2s": "Complex question answered in 2 seconds",
          "analytical_question_1s": "Analytical question answered in 1 second"
        },
        "risk_weight": 0.4,
        "severity": "high",
        "interpretation": "Likely pre-prepared answer or AI assistance"
      },
      "unnatural_consistency": {
        "description": "Robotic pause patterns with very low variation",
        "detection": "Pause duration std dev < 0.1s OR consistency_score > 0.9",
        "examples": {
          "regular_pauses": "Pauses every 5 seconds, each exactly 0.5s",
          "uniform_spacing": "Perfectly spaced pauses throughout"
        },
        "risk_weight": 0.2,
        "severity": "medium",
        "interpretation": "AI-generated speech read aloud or TTS"
      },
      "delayed_then_fluent": {
        "description": "Long delay before answering, then very fluent speech",
        "detection": "Latency > 200% expected AND filler_ratio < 1% AND pause_percentage < 10%",
        "examples": {
          "30s_delay_then_perfect": "30 second delay, then perfect fluent answer",
          "reading_prepared_answer": "Long pause to find answer, then reading"
        },
        "risk_weight": 0.3,
        "severity": "high",
        "interpretation": "Reading pre-written answer (human or AI-generated)"
      },
      "robotic_speech_pattern": {
        "description": "TTS-like speech with consistent pace and minimal variation",
        "detection": "Normal WPM range AND <2% fillers AND <10% pauses AND regular patterns",
        "characteristics": {
          "wpm": "140-160 (consistent AI TTS range)",
          "filler_ratio": "<0.02 (<2%)",
          "pause_percentage": "<10%",
          "regular_spacing": true,
          "uniform_duration": true
        },
        "risk_weight": 0.25,
        "severity": "high",
        "interpretation": "Text-to-speech or heavily scripted response"
      },
      "no_fillers": {
        "description": "Complete or near-complete absence of filler words",
        "detection": "Filler ratio < 1% AND total_words > 50",
        "risk_weight": 0.15,
        "severity": "medium",
        "interpretation": "Unnatural for spontaneous speech, suggests reading"
      },
      "excessive_speed": {
        "description": "Unusually fast speech rate indicating reading",
        "detection": "Speech rate > 200 WPM",
        "risk_weight": 0.2,
        "severity": "medium to high",
        "interpretation": "Reading aloud rather than spontaneous speaking",
        "note": "250+ WPM is very high confidence of reading"
      }
    },
    "risk_scoring": {
      "description": "Overall risk score calculation (0-1)",
      "formula": "sum(anomaly_weights) capped at 1.0",
      "risk_levels": {
        "low": {
          "range": "0.00-0.25",
          "recommendation": "Timing patterns appear natural"
        },
        "medium": {
          "range": "0.25-0.50",
          "recommendation": "Some timing anomalies detected - review recommended"
        },
        "high": {
          "range": "0.50-0.75",
          "recommendation": "Multiple timing anomalies detected - manual review required"
        },
        "critical": {
          "range": "0.75-1.00",
          "recommendation": "Severe timing anomalies - likely AI-assisted or pre-prepared response"
        }
      }
    }
  },
  "api_endpoints": {
    "analyze_audio": {
      "method": "POST",
      "path": "/api/v1/timing/analyze",
      "description": "Analyze audio for timing metrics and anomalies",
      "request": {
        "question_id": "UUID - Question identifier",
        "audio_url": "string - S3 URL of audio file",
        "question_asked_at": "ISO8601 - When question was asked",
        "answer_start_timestamp": "ISO8601 - When answer started",
        "difficulty": "string - simple|analytical|complex"
      },
      "response": {
        "analysis_id": "UUID - Unique analysis identifier",
        "transcription": {
          "text": "string - Full transcription",
          "confidence": "float - 0-1",
          "words": "array - First 100 word timestamps"
        },
        "timing_metrics": {
          "response_latency_ms": "int - Question to answer latency",
          "speech_duration_seconds": "float - Actual speech time",
          "total_duration_seconds": "float - Total audio duration",
          "speech_rate_wpm": "float - Words per minute",
          "pause_count": "int - Number of pauses",
          "pause_percentage": "float - % time in pauses",
          "avg_pause_duration_seconds": "float - Average pause length",
          "filler_word_count": "int - Number of fillers",
          "filler_word_ratio": "float - Filler ratio 0-1"
        },
        "anomalies": {
          "instant_response": "bool",
          "unnatural_consistency": "bool",
          "delayed_then_fluent": "bool",
          "robotic_speech_pattern": "bool"
        },
        "risk_score": "float - 0-1",
        "recommendation": "string - Suggested action"
      },
      "performance": {
        "avg_duration": "10-15 seconds for 5-minute audio",
        "timeout": 120000,
        "max_audio_size": "25 MB"
      }
    },
    "get_status": {
      "method": "GET",
      "path": "/api/v1/timing/status/{analysis_id}",
      "description": "Get status of analysis job",
      "response": {
        "analysis_id": "UUID",
        "question_id": "UUID",
        "status": "completed|processing|failed",
        "response_timing": "JSONB - Timing metrics",
        "risk_score": "float",
        "analyzed_at": "ISO8601"
      }
    },
    "health_check": {
      "method": "GET",
      "path": "/api/v1/health",
      "description": "Basic health check",
      "response": {
        "status": "healthy",
        "service": "Response Timing Service",
        "version": "1.0.0"
      }
    },
    "readiness": {
      "method": "GET",
      "path": "/api/v1/health/ready",
      "description": "Readiness check",
      "checks": ["database"]
    },
    "liveness": {
      "method": "GET",
      "path": "/api/v1/health/live",
      "description": "Liveness check"
    }
  },
  "database_integration": {
    "table": "answer_analysis",
    "columns_updated": {
      "transcription_text": "TEXT - Full transcription",
      "response_timing": {
        "type": "JSONB",
        "structure": {
          "response_latency_ms": "int",
          "speech_duration_seconds": "float",
          "total_duration_seconds": "float",
          "speech_rate_wpm": "float",
          "pause_count": "int",
          "pause_percentage": "float",
          "avg_pause_duration_seconds": "float",
          "filler_word_count": "int",
          "filler_word_ratio": "float",
          "anomalies": {
            "instant_response": "bool",
            "unnatural_consistency": "bool",
            "delayed_then_fluent": "bool",
            "robotic_speech_pattern": "bool"
          },
          "risk_score": "float"
        }
      },
      "risk_score": "DECIMAL(5,4) - Overall timing risk score",
      "metadata": {
        "timing_analysis": {
          "analysis_id": "UUID",
          "analyzed_at": "ISO8601",
          "transcription_confidence": "float",
          "language": "string"
        }
      }
    }
  },
