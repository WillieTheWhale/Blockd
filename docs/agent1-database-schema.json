{
  "project": "Blockd Platform",
  "agent": "Agent 1: Database Architect",
  "version": "1.0.0",
  "created": "2025-11-24",
  "database": {
    "type": "PostgreSQL",
    "version": "18.1",
    "extensions": [
      {
        "name": "uuid-ossp",
        "version": "latest",
        "purpose": "UUID generation functions"
      },
      {
        "name": "pgvector",
        "version": "0.7.x",
        "purpose": "Vector similarity search for AI answer detection"
      },
      {
        "name": "timescaledb",
        "version": "2.x",
        "purpose": "Time-series data optimization for gaze events and telemetry"
      },
      {
        "name": "pgcrypto",
        "version": "latest",
        "purpose": "Cryptographic functions for secure token generation"
      }
    ]
  },
  "connection": {
    "format": "postgresql://user:password@host:port/database",
    "default": "postgresql://blockd_app:blockd_secure_password_2025@localhost:5432/blockd",
    "environment_variable": "DATABASE_URL",
    "pooling": {
      "recommended": true,
      "min_connections": 5,
      "max_connections": 20,
      "connection_timeout": 30000
    }
  },
  "tables": {
    "organizations": {
      "description": "Stores organization information and subscription details",
      "primary_key": "id (UUID)",
      "columns": [
        {"name": "id", "type": "UUID", "nullable": false, "default": "uuid_generate_v4()"},
        {"name": "name", "type": "VARCHAR(255)", "nullable": false},
        {"name": "subscription_tier", "type": "subscription_tier ENUM", "nullable": false, "default": "free"},
        {"name": "settings", "type": "JSONB", "nullable": true, "default": "{}"},
        {"name": "max_concurrent_sessions", "type": "INTEGER", "nullable": true, "default": 5},
        {"name": "monthly_session_limit", "type": "INTEGER", "nullable": true, "default": 100},
        {"name": "created_at", "type": "TIMESTAMPTZ", "nullable": false, "default": "NOW()"},
        {"name": "updated_at", "type": "TIMESTAMPTZ", "nullable": false, "default": "NOW()"},
        {"name": "deleted_at", "type": "TIMESTAMPTZ", "nullable": true}
      ],
      "indexes": [
        {"name": "idx_organizations_tier", "columns": ["subscription_tier"], "type": "btree"}
      ],
      "relationships": [
        {"type": "has_many", "table": "users", "foreign_key": "organization_id"},
        {"type": "has_many", "table": "interview_sessions", "foreign_key": "organization_id"}
      ]
    },
    "users": {
      "description": "Stores user accounts with authentication and MFA support",
      "primary_key": "id (UUID)",
      "columns": [
        {"name": "id", "type": "UUID", "nullable": false, "default": "uuid_generate_v4()"},
        {"name": "email", "type": "VARCHAR(255)", "nullable": false, "unique": true},
        {"name": "password_hash", "type": "VARCHAR(255)", "nullable": false, "note": "bcrypt hash"},
        {"name": "role", "type": "user_role ENUM", "nullable": false, "default": "interviewee"},
        {"name": "organization_id", "type": "UUID", "nullable": true, "foreign_key": "organizations.id"},
        {"name": "first_name", "type": "VARCHAR(100)", "nullable": true},
        {"name": "last_name", "type": "VARCHAR(100)", "nullable": true},
        {"name": "mfa_enabled", "type": "BOOLEAN", "nullable": true, "default": false},
        {"name": "mfa_secret", "type": "VARCHAR(255)", "nullable": true},
        {"name": "email_verified", "type": "BOOLEAN", "nullable": true, "default": false},
        {"name": "last_login_at", "type": "TIMESTAMPTZ", "nullable": true},
        {"name": "created_at", "type": "TIMESTAMPTZ", "nullable": false, "default": "NOW()"},
        {"name": "updated_at", "type": "TIMESTAMPTZ", "nullable": false, "default": "NOW()"},
        {"name": "deleted_at", "type": "TIMESTAMPTZ", "nullable": true}
      ],
      "indexes": [
        {"name": "idx_users_email", "columns": ["email"], "type": "btree"},
        {"name": "idx_users_organization", "columns": ["organization_id"], "type": "btree"},
        {"name": "idx_users_role", "columns": ["role"], "type": "btree"}
      ],
      "relationships": [
        {"type": "belongs_to", "table": "organizations", "foreign_key": "organization_id"},
        {"type": "has_many", "table": "interview_sessions", "foreign_key": "interviewer_id"},
        {"type": "has_many", "table": "interview_sessions", "foreign_key": "interviewee_id"}
      ]
    },
    "interview_sessions": {
      "description": "Tracks all interview sessions with status and metadata",
      "primary_key": "id (UUID)",
      "columns": [
        {"name": "id", "type": "UUID", "nullable": false, "default": "uuid_generate_v4()"},
        {"name": "interviewer_id", "type": "UUID", "nullable": false, "foreign_key": "users.id"},
        {"name": "interviewee_id", "type": "UUID", "nullable": true, "foreign_key": "users.id"},
        {"name": "interviewee_email", "type": "VARCHAR(255)", "nullable": true},
        {"name": "organization_id", "type": "UUID", "nullable": false, "foreign_key": "organizations.id"},
        {"name": "status", "type": "session_status ENUM", "nullable": false, "default": "scheduled"},
        {"name": "session_token", "type": "VARCHAR(255)", "nullable": true, "unique": true, "note": "Auto-generated"},
        {"name": "scheduled_start", "type": "TIMESTAMPTZ", "nullable": true},
        {"name": "actual_start", "type": "TIMESTAMPTZ", "nullable": true},
        {"name": "actual_end", "type": "TIMESTAMPTZ", "nullable": true},
        {"name": "duration_minutes", "type": "INTEGER", "nullable": true, "note": "Auto-calculated"},
        {"name": "risk_score", "type": "DECIMAL(5,4)", "nullable": true, "constraint": "0-1"},
        {"name": "video_url", "type": "TEXT", "nullable": true},
        {"name": "recording_url", "type": "TEXT", "nullable": true},
        {"name": "metadata", "type": "JSONB", "nullable": true, "default": "{}"},
        {"name": "created_at", "type": "TIMESTAMPTZ", "nullable": false, "default": "NOW()"},
        {"name": "updated_at", "type": "TIMESTAMPTZ", "nullable": false, "default": "NOW()"}
      ],
      "indexes": [
        {"name": "idx_sessions_interviewer", "columns": ["interviewer_id"], "type": "btree"},
        {"name": "idx_sessions_interviewee", "columns": ["interviewee_id"], "type": "btree"},
        {"name": "idx_sessions_org_status", "columns": ["organization_id", "status"], "type": "btree"},
        {"name": "idx_sessions_status", "columns": ["status"], "type": "btree"},
        {"name": "idx_sessions_scheduled_start", "columns": ["scheduled_start"], "type": "btree"},
        {"name": "idx_sessions_token", "columns": ["session_token"], "type": "btree"}
      ],
      "triggers": [
        {"name": "generate_interview_session_token", "event": "BEFORE INSERT", "function": "generate_session_token()"},
        {"name": "calculate_interview_duration", "event": "BEFORE UPDATE", "function": "calculate_session_duration()"}
      ]
    },
    "security_events": {
      "description": "Records security-related events during sessions",
      "primary_key": "id (UUID)",
      "columns": [
        {"name": "id", "type": "UUID", "nullable": false, "default": "uuid_generate_v4()"},
        {"name": "session_id", "type": "UUID", "nullable": false, "foreign_key": "interview_sessions.id"},
        {"name": "event_type", "type": "security_event_type ENUM", "nullable": false},
        {"name": "severity", "type": "severity_level ENUM", "nullable": false, "default": "medium"},
        {"name": "description", "type": "TEXT", "nullable": true},
        {"name": "metadata", "type": "JSONB", "nullable": true, "default": "{}"},
        {"name": "timestamp", "type": "TIMESTAMPTZ", "nullable": false, "default": "NOW()"},
        {"name": "created_at", "type": "TIMESTAMPTZ", "nullable": false, "default": "NOW()"}
      ],
      "indexes": [
        {"name": "idx_security_events_session", "columns": ["session_id"], "type": "btree"},
        {"name": "idx_security_events_session_time", "columns": ["session_id", "timestamp DESC"], "type": "btree"},
        {"name": "idx_security_events_type", "columns": ["event_type"], "type": "btree"},
        {"name": "idx_security_events_severity", "columns": ["severity"], "type": "btree"}
      ]
    },
    "questions": {
      "description": "Stores interview questions asked during sessions",
      "primary_key": "id (UUID)",
      "columns": [
        {"name": "id", "type": "UUID", "nullable": false, "default": "uuid_generate_v4()"},
        {"name": "session_id", "type": "UUID", "nullable": false, "foreign_key": "interview_sessions.id"},
        {"name": "question_text", "type": "TEXT", "nullable": false},
        {"name": "question_order", "type": "INTEGER", "nullable": true},
        {"name": "expected_duration", "type": "INTEGER", "nullable": true, "note": "seconds"},
        {"name": "difficulty", "type": "question_difficulty ENUM", "nullable": true},
        {"name": "asked_at", "type": "TIMESTAMPTZ", "nullable": true},
        {"name": "created_at", "type": "TIMESTAMPTZ", "nullable": false, "default": "NOW()"},
        {"name": "updated_at", "type": "TIMESTAMPTZ", "nullable": false, "default": "NOW()"}
      ],
      "indexes": [
        {"name": "idx_questions_session", "columns": ["session_id"], "type": "btree"},
        {"name": "idx_questions_session_order", "columns": ["session_id", "question_order"], "type": "btree"}
      ]
    },
    "ai_answer_cache": {
      "description": "Caches AI-generated answers with vector embeddings for similarity search",
      "primary_key": "id (UUID)",
      "columns": [
        {"name": "id", "type": "UUID", "nullable": false, "default": "uuid_generate_v4()"},
        {"name": "question_hash", "type": "VARCHAR(64)", "nullable": false},
        {"name": "question_text", "type": "TEXT", "nullable": false},
        {"name": "model_name", "type": "ai_model_name ENUM", "nullable": false},
        {"name": "answer_text", "type": "TEXT", "nullable": false},
        {"name": "embedding", "type": "vector(384)", "nullable": true, "note": "384-dimensional vector for sentence-transformers"},
        {"name": "perplexity_score", "type": "DECIMAL(10,6)", "nullable": true},
        {"name": "token_count", "type": "INTEGER", "nullable": true},
        {"name": "metadata", "type": "JSONB", "nullable": true, "default": "{}"},
        {"name": "created_at", "type": "TIMESTAMPTZ", "nullable": false, "default": "NOW()"}
      ],
      "indexes": [
        {"name": "idx_ai_answer_cache_hash", "columns": ["question_hash"], "type": "btree"},
        {"name": "idx_ai_answer_cache_model", "columns": ["model_name"], "type": "btree"},
        {"name": "idx_ai_answer_embedding", "columns": ["embedding"], "type": "ivfflat", "ops": "vector_cosine_ops", "parameters": {"lists": 100}}
      ],
      "constraints": [
        {"type": "unique", "columns": ["question_hash", "model_name"]}
      ]
    },
    "answer_analysis": {
      "description": "Stores analysis results for interviewee answers",
      "primary_key": "id (UUID)",
      "columns": [
        {"name": "id", "type": "UUID", "nullable": false, "default": "uuid_generate_v4()"},
        {"name": "question_id", "type": "UUID", "nullable": false, "foreign_key": "questions.id"},
        {"name": "answer_text", "type": "TEXT", "nullable": false},
        {"name": "answer_audio_url", "type": "TEXT", "nullable": true},
        {"name": "transcription_text", "type": "TEXT", "nullable": true},
        {"name": "risk_score", "type": "DECIMAL(5,4)", "nullable": true, "constraint": "0-1"},
        {"name": "similarity_scores", "type": "JSONB", "nullable": true, "default": "{}", "note": "{model_name: score}"},
        {"name": "response_timing", "type": "JSONB", "nullable": true, "default": "{}", "note": "{latency_ms, wpm, pause_count, filler_ratio}"},
        {"name": "perplexity_score", "type": "DECIMAL(10,6)", "nullable": true},
        {"name": "is_ai_generated", "type": "BOOLEAN", "nullable": true},
        {"name": "confidence_score", "type": "DECIMAL(5,4)", "nullable": true},
        {"name": "metadata", "type": "JSONB", "nullable": true, "default": "{}"},
        {"name": "analyzed_at", "type": "TIMESTAMPTZ", "nullable": false, "default": "NOW()"},
        {"name": "created_at", "type": "TIMESTAMPTZ", "nullable": false, "default": "NOW()"}
      ],
      "indexes": [
        {"name": "idx_answer_analysis_question", "columns": ["question_id"], "type": "btree"},
        {"name": "idx_answer_analysis_risk_score", "columns": ["risk_score DESC"], "type": "btree"},
        {"name": "idx_answer_analysis_ai_generated", "columns": ["is_ai_generated"], "type": "btree"}
      ]
    },
    "gaze_events": {
      "description": "TimescaleDB hypertable for eye tracking data",
      "type": "hypertable",
      "partition_key": "timestamp",
      "chunk_interval": "1 day",
      "retention_policy": "30 days",
      "compression": {
        "enabled": true,
        "after": "7 days",
        "segment_by": "session_id",
        "order_by": "timestamp DESC"
      },
      "columns": [
        {"name": "id", "type": "UUID", "nullable": true, "default": "uuid_generate_v4()"},
        {"name": "session_id", "type": "UUID", "nullable": false, "foreign_key": "interview_sessions.id"},
        {"name": "timestamp", "type": "TIMESTAMPTZ", "nullable": false, "note": "Partition key"},
        {"name": "gaze_x", "type": "DECIMAL(10,8)", "nullable": true, "note": "normalized 0-1"},
        {"name": "gaze_y", "type": "DECIMAL(10,8)", "nullable": true, "note": "normalized 0-1"},
        {"name": "is_off_screen", "type": "BOOLEAN", "nullable": true, "default": false},
        {"name": "off_screen_direction", "type": "VARCHAR(20)", "nullable": true, "note": "left, right, up, down"},
        {"name": "confidence", "type": "DECIMAL(5,4)", "nullable": true},
        {"name": "pupil_diameter_left", "type": "DECIMAL(10,6)", "nullable": true},
        {"name": "pupil_diameter_right", "type": "DECIMAL(10,6)", "nullable": true},
        {"name": "metadata", "type": "JSONB", "nullable": true, "default": "{}"}
      ],
      "indexes": [
        {"name": "idx_gaze_events_session_time", "columns": ["session_id", "timestamp DESC"], "type": "btree"},
        {"name": "idx_gaze_events_off_screen", "columns": ["session_id", "is_off_screen"], "type": "btree"}
      ]
    },
    "browser_telemetry": {
      "description": "TimescaleDB hypertable for browser telemetry data",
      "type": "hypertable",
      "partition_key": "timestamp",
      "chunk_interval": "1 day",
      "retention_policy": "30 days",
      "compression": {
        "enabled": true,
        "after": "7 days",
        "segment_by": "session_id",
        "order_by": "timestamp DESC"
      },
      "columns": [
        {"name": "id", "type": "UUID", "nullable": true, "default": "uuid_generate_v4()"},
        {"name": "session_id", "type": "UUID", "nullable": false, "foreign_key": "interview_sessions.id"},
        {"name": "timestamp", "type": "TIMESTAMPTZ", "nullable": false, "note": "Partition key"},
        {"name": "cpu_percent", "type": "DECIMAL(5,2)", "nullable": true},
        {"name": "memory_mb", "type": "INTEGER", "nullable": true},
        {"name": "active_processes", "type": "JSONB", "nullable": true, "default": "[]"},
        {"name": "window_title", "type": "VARCHAR(500)", "nullable": true},
        {"name": "browser_tabs_count", "type": "INTEGER", "nullable": true},
        {"name": "network_requests", "type": "JSONB", "nullable": true, "default": "[]"},
        {"name": "metadata", "type": "JSONB", "nullable": true, "default": "{}"}
      ],
      "indexes": [
        {"name": "idx_browser_telemetry_session_time", "columns": ["session_id", "timestamp DESC"], "type": "btree"}
      ]
    },
    "session_reports": {
      "description": "Stores final session analysis reports",
      "primary_key": "id (UUID)",
      "columns": [
        {"name": "id", "type": "UUID", "nullable": false, "default": "uuid_generate_v4()"},
        {"name": "session_id", "type": "UUID", "nullable": false, "foreign_key": "interview_sessions.id", "unique": true},
        {"name": "overall_risk_score", "type": "DECIMAL(5,4)", "nullable": true, "constraint": "0-1"},
        {"name": "ai_detection_score", "type": "DECIMAL(5,4)", "nullable": true},
        {"name": "gaze_anomaly_score", "type": "DECIMAL(5,4)", "nullable": true},
        {"name": "timing_anomaly_score", "type": "DECIMAL(5,4)", "nullable": true},
        {"name": "security_events_count", "type": "INTEGER", "nullable": true, "default": 0},
        {"name": "recommendations", "type": "JSONB", "nullable": true, "default": "[]"},
        {"name": "detailed_analysis", "type": "JSONB", "nullable": true, "default": "{}"},
        {"name": "generated_at", "type": "TIMESTAMPTZ", "nullable": false, "default": "NOW()"},
        {"name": "created_at", "type": "TIMESTAMPTZ", "nullable": false, "default": "NOW()"}
      ],
      "indexes": [
        {"name": "idx_session_reports_session", "columns": ["session_id"], "type": "btree"},
        {"name": "idx_session_reports_risk_score", "columns": ["overall_risk_score DESC"], "type": "btree"}
      ]
    },
    "audit_logs": {
      "description": "Tracks all user actions for security and compliance",
      "primary_key": "id (UUID)",
      "columns": [
        {"name": "id", "type": "UUID", "nullable": false, "default": "uuid_generate_v4()"},
        {"name": "user_id", "type": "UUID", "nullable": true, "foreign_key": "users.id"},
        {"name": "action", "type": "VARCHAR(100)", "nullable": false},
        {"name": "resource_type", "type": "VARCHAR(100)", "nullable": false},
        {"name": "resource_id", "type": "UUID", "nullable": true},
        {"name": "ip_address", "type": "INET", "nullable": true},
        {"name": "user_agent", "type": "TEXT", "nullable": true},
        {"name": "metadata", "type": "JSONB", "nullable": true, "default": "{}"},
        {"name": "timestamp", "type": "TIMESTAMPTZ", "nullable": false, "default": "NOW()"},
        {"name": "created_at", "type": "TIMESTAMPTZ", "nullable": false, "default": "NOW()"}
      ],
      "indexes": [
        {"name": "idx_audit_logs_user", "columns": ["user_id"], "type": "btree"},
        {"name": "idx_audit_logs_resource", "columns": ["resource_type", "resource_id"], "type": "btree"},
        {"name": "idx_audit_logs_timestamp", "columns": ["timestamp DESC"], "type": "btree"},
        {"name": "idx_audit_logs_action", "columns": ["action"], "type": "btree"}
      ]
    }
  },
  "enums": {
    "user_role": ["admin", "interviewer", "interviewee"],
    "subscription_tier": ["free", "professional", "enterprise"],
    "session_status": ["scheduled", "active", "ended", "cancelled"],
    "security_event_type": [
      "suspicious_process",
      "screen_recording_detected",
      "vm_detected",
      "window_focus_changed",
      "multi_monitor_detected",
      "unauthorized_browser",
      "copy_paste_detected",
      "keyboard_shortcut_blocked"
    ],
    "severity_level": ["low", "medium", "high", "critical"],
    "question_difficulty": ["easy", "medium", "hard", "expert"],
    "ai_model_name": ["gpt-4", "gpt-3.5-turbo", "claude-3-opus", "claude-3-sonnet", "gemini-pro", "llama-2"]
  },
  "views": {
    "active_sessions": {
      "description": "Shows all currently active interview sessions with participant details",
      "columns": ["id", "session_token", "scheduled_start", "actual_start", "interviewer_email", "interviewer_first_name", "interviewer_last_name", "interviewee_email", "interviewee_first_name", "interviewee_last_name", "organization_name", "risk_score", "security_events_count"]
    },
    "session_analytics": {
      "description": "Aggregated analytics for all sessions",
      "columns": ["session_id", "organization_id", "status", "duration_minutes", "risk_score", "questions_count", "answers_count", "security_events_count", "avg_answer_risk_score", "gaze_events_count", "off_screen_events_count"]
    },
    "high_risk_sessions": {
      "description": "Sessions with risk score >= 0.75",
      "columns": ["id", "session_token", "actual_start", "actual_end", "risk_score", "interviewer_email", "organization_name", "security_events_count", "recommendations"]
    }
  },
  "functions": {
    "get_session_risk_summary": {
      "description": "Returns comprehensive risk summary for a session",
      "parameters": ["p_session_id UUID"],
      "returns": "TABLE (session_id, overall_risk_score, security_events_count, high_severity_events, ai_answers_count, off_screen_count, total_duration_minutes)"
    },
    "find_similar_ai_answers": {
      "description": "Finds similar AI answers using vector similarity search",
      "parameters": ["p_embedding vector(384)", "p_limit INTEGER", "p_threshold DECIMAL"],
      "returns": "TABLE (id, question_text, model_name, answer_text, similarity_score)",
      "note": "Uses pgvector cosine similarity"
    }
  },
  "relationships_diagram": {
    "description": "Entity Relationship Diagram in text format",
    "entities": {
      "organizations": {
        "relationships": [
          "organizations 1 ---> * users",
          "organizations 1 ---> * interview_sessions"
        ]
      },
      "users": {
        "relationships": [
          "users * <--- 1 organizations (optional)",
          "users 1 ---> * interview_sessions (as interviewer)",
          "users 1 ---> * interview_sessions (as interviewee, optional)"
        ]
      },
      "interview_sessions": {
        "relationships": [
          "interview_sessions * <--- 1 organizations",
          "interview_sessions * <--- 1 users (interviewer_id)",
          "interview_sessions * <--- 0..1 users (interviewee_id)",
          "interview_sessions 1 ---> * questions",
          "interview_sessions 1 ---> * security_events",
          "interview_sessions 1 ---> * gaze_events",
          "interview_sessions 1 ---> * browser_telemetry",
          "interview_sessions 1 ---> 0..1 session_reports"
        ]
      },
      "questions": {
        "relationships": [
          "questions * <--- 1 interview_sessions",
          "questions 1 ---> * answer_analysis"
        ]
      },
      "answer_analysis": {
        "relationships": [
          "answer_analysis * <--- 1 questions"
        ]
      }
    }
  },
  "index_strategy": {
    "description": "Indexing strategy for optimal query performance",
    "btree_indexes": {
      "purpose": "Standard lookups and range queries",
      "examples": [
        "idx_users_email - Fast user lookup by email",
        "idx_sessions_org_status - Filter sessions by organization and status",
        "idx_security_events_session_time - Time-ordered security events"
      ]
    },
    "vector_indexes": {
      "purpose": "Vector similarity search for AI detection",
      "type": "IVFFlat",
      "examples": [
        "idx_ai_answer_embedding - Fast cosine similarity search for AI answers"
      ],
      "parameters": {
        "lists": 100,
        "distance_metric": "cosine",
        "note": "Adjust lists parameter based on dataset size (sqrt(rows) is a good starting point)"
      }
    },
    "timescaledb_indexes": {
      "purpose": "Optimized time-series queries",
      "automatic": "TimescaleDB automatically creates indexes on partition keys",
      "custom": [
        "idx_gaze_events_session_time - Session-specific gaze event queries",
        "idx_browser_telemetry_session_time - Session-specific telemetry queries"
      ]
    }
  },
  "performance_optimizations": {
    "timescaledb": {
      "hypertables": ["gaze_events", "browser_telemetry"],
      "chunk_interval": "1 day",
      "retention_policy": "30 days (automatic deletion)",
      "compression": {
        "enabled": true,
