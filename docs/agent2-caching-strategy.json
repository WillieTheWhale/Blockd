    "study": {
      "pattern": "study:{study_id}",
      "description": "Study configuration and settings",
      "ttl_seconds": 604800,
      "ttl_description": "7 days",
      "example": "study:study_987654321",
      "data_structure": "string (JSON serialized)",
      "use_case": "Cache study configuration to reduce database load"
    },
    "analytics": {
      "pattern": "analytics:{study_id}:{metric_type}",
