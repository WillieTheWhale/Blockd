  "state_management": {
    "zustand_stores": [
      {
        "name": "auth-store",
        "purpose": "Authentication state management",
        "state": [
          "user",
          "isAuthenticated",
          "isLoading",
          "error"
        ],
        "actions": [
          "setUser",
          "setTokens",
          "logout",
          "setLoading",
          "setError",
          "clearError"
        ],
        "persistence": true
      },
      {
        "name": "session-store",
        "purpose": "Current session state management",
        "state": [
          "currentSession",
          "currentQuestions",
          "currentQuestionIndex",
          "isSessionActive",
          "sessionStartTime",
          "questionStartTime"
        ],
        "actions": [
          "setCurrentSession",
          "setCurrentQuestions",
          "startSession",
          "endSession",
          "nextQuestion",
          "previousQuestion",
          "goToQuestion",
          "startQuestionTimer",
          "clearSession"
        ],
        "persistence": false
      },
      {
        "name": "ui-store",
        "purpose": "UI state management",
        "state": [
          "theme",
          "sidebarOpen",
          "modal"
        ],
        "actions": [
          "setTheme",
          "toggleSidebar",
          "setSidebarOpen",
          "openModal",
          "closeModal"
        ],
        "persistence": false
      }
    ]
