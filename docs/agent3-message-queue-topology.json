  "message_flows": {
    "video_processing_flow": {
      "description": "Complete video processing pipeline",
      "steps": [
        {
          "step": 1,
          "action": "User uploads video via API",
          "component": "FastAPI/Fastify endpoint"
        },
        {
          "step": 2,
          "action": "API publishes to video_processing exchange",
          "routing_key": "video.encode.{video_id}",
          "exchange": "video_processing"
        },
        {
          "step": 3,
          "action": "Message routed to video_encode queue",
          "queue": "video_encode"
        },
        {
          "step": 4,
          "action": "Celery worker processes with FFmpeg",
          "worker": "tasks.video.encode"
        },
        {
          "step": 5,
          "action": "On success, publish thumbnail task",
          "routing_key": "video.thumbnail.{video_id}"
        },
        {
          "step": 6,
          "action": "On thumbnail complete, publish upload task",
          "routing_key": "video.upload.{video_id}"
        },
        {
          "step": 7,
          "action": "Final result stored in Redis backend",
          "backend": "Redis"
        }
      ],
      "retry_policy": {
        "max_retries": 3,
        "retry_delay": 60,
        "backoff": "exponential",
        "backoff_max": 600
      },
      "failure_handling": "Messages failing all retries move to DLQ for manual inspection"
    },
    "ai_detection_flow": {
      "description": "AI-powered answer analysis pipeline",
      "steps": [
        {
          "step": 1,
          "action": "Student submits answer",
          "component": "API endpoint"
        },
        {
          "step": 2,
          "action": "Publish to ai_detection exchange",
          "routing_key": "ai.analyze.{exam_id}",
          "exchange": "ai_detection"
        },
        {
          "step": 3,
          "action": "Message routed to ai_analyze queue",
          "queue": "ai_analyze"
        },
        {
          "step": 4,
          "action": "Celery worker runs ML models",
          "worker": "tasks.ai.analyze",
          "models": ["XGBoost", "sentence-transformers"]
        },
        {
          "step": 5,
          "action": "Generate embedding for similarity search",
          "routing_key": "ai.embedding.{exam_id}"
        },
        {
          "step": 6,
          "action": "Update cache with results",
          "routing_key": "ai.cache.{cache_key}"
        },
        {
          "step": 7,
          "action": "Return analysis results",
          "backend": "Redis + PostgreSQL"
        }
      ],
      "retry_policy": {
        "max_retries": 3,
        "retry_delay": 60,
        "backoff": "exponential"
      }
    },
    "security_event_flow": {
      "description": "Security event broadcasting",
      "steps": [
        {
          "step": 1,
          "action": "Security event detected",
          "source": "Browser extension, API, monitoring"
        },
        {
          "step": 2,
          "action": "Publish to security_events exchange",
          "exchange": "security_events",
          "type": "fanout"
        },
        {
          "step": 3,
          "action": "Broadcast to all bound queues",
          "queues": ["security_alert", "security_log"]
        },
        {
          "step": 4,
          "action": "Real-time alert processing",
          "worker": "tasks.security.alert",
          "actions": ["Send notification", "Update dashboard"]
        },
        {
          "step": 5,
          "action": "Audit log storage",
          "worker": "tasks.security.log",
          "storage": "PostgreSQL + TimescaleDB"
        }
      ],
      "priority": "critical",
      "latency_target": "< 100ms"
    },
    "gaze_analysis_flow": {
      "description": "Eye tracking analysis pipeline",
      "steps": [
        {
          "step": 1,
          "action": "Browser captures gaze data",
          "component": "MediaPipe in browser extension"
        },
        {
          "step": 2,
          "action": "Batch and publish to gaze_analysis exchange",
          "routing_key": "gaze.process.{session_id}"
        },
        {
          "step": 3,
          "action": "Process gaze coordinates",
          "worker": "tasks.gaze.process",
          "outputs": ["Fixation points", "Saccades", "Heatmap data"]
        },
        {
          "step": 4,
          "action": "Detect anomalies",
          "routing_key": "gaze.anomaly.{session_id}",
          "worker": "tasks.gaze.anomaly"
        },
        {
          "step": 5,
          "action": "Store results",
          "storage": "PostgreSQL + TimescaleDB"
        }
      ],
      "batch_size": "100 points",
      "batch_interval": "5 seconds"
    }
