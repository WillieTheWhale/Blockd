{
  "agent": {
    "id": "agent12",
    "name": "Video Processing Service Developer",
    "role": "WebRTC Streaming, Recording, and Video Storage",
    "completed_date": "2025-11-24",
    "technology_stack": {
      "python": "3.14.0",
      "nodejs": "24.11.0",
      "fastapi": "0.121.3",
      "mediasoup": "3.19.11",
      "ffmpeg": "7.x"
    }
  },
  "service_overview": {
    "name": "Video Processing Service",
    "description": "Production-grade video processing service with WebRTC streaming, FFmpeg recording, and S3 storage",
    "api_port": 8003,
    "mediasoup_port": 3000,
    "components": [
      {
        "name": "FastAPI Server",
        "language": "Python",
        "purpose": "REST API, recording management, business logic"
      },
      {
        "name": "mediasoup Server",
        "language": "TypeScript/Node.js",
        "purpose": "WebRTC SFU for real-time streaming"
      }
    ]
  },
  "features": {
    "webrtc_streaming": {
      "description": "Real-time audio/video streaming using mediasoup SFU",
      "capabilities": [
        "Selective Forwarding Unit (SFU) architecture",
        "Multiple codec support (VP8, VP9, H.264, Opus)",
        "Simulcast support",
        "100+ concurrent streams",
        "Dynamic bitrate adaptation"
      ],
      "codecs": {
        "audio": [
          {
            "name": "Opus",
            "mime_type": "audio/opus",
            "clock_rate": 48000,
            "channels": 2
          }
        ],
        "video": [
          {
            "name": "VP8",
            "mime_type": "video/VP8",
            "clock_rate": 90000
          },
          {
            "name": "VP9",
            "mime_type": "video/VP9",
            "clock_rate": 90000
          },
          {
            "name": "H.264",
            "mime_type": "video/h264",
            "clock_rate": 90000,
            "parameters": {
              "packetization-mode": 1,
              "profile-level-id": "4d0032"
            }
          }
        ]
      }
    },
    "recording": {
      "description": "FFmpeg-based recording of interview sessions",
      "capabilities": [
        "Live recording from RTMP/RTP streams",
        "H.264 video encoding",
        "AAC audio encoding",
        "MP4 container with faststart",
        "Configurable bitrate and quality",
        "Maximum duration limit (2 hours default)"
      ],
      "default_settings": {
        "video_codec": "libx264",
        "video_bitrate": "2000k",
        "video_preset": "veryfast",
        "audio_codec": "aac",
        "audio_bitrate": "128k",
        "audio_sample_rate": 44100,
        "format": "mp4",
        "max_duration": 7200
      }
    },
    "adaptive_bitrate": {
      "description": "Automatic generation of multiple resolution versions",
      "resolutions": [
        {
          "name": "240p",
          "height": 240,
          "bitrate": "400k",
          "maxrate": "500k"
        },
        {
          "name": "360p",
          "height": 360,
          "bitrate": "800k",
          "maxrate": "1000k"
        },
        {
          "name": "480p",
          "height": 480,
          "bitrate": "1200k",
          "maxrate": "1500k"
        },
        {
          "name": "720p",
          "height": 720,
          "bitrate": "2500k",
          "maxrate": "3000k"
        }
      ],
      "use_case": "Adaptive streaming for different network conditions and device capabilities"
    },
    "storage": {
      "description": "S3-compatible storage for video files",
      "capabilities": [
        "Upload to AWS S3, MinIO, or Cloudflare R2",
        "Multipart upload for large files",
        "Pre-signed URLs (7-day expiry)",
        "Automatic cleanup after retention period",
        "Storage statistics tracking"
      ],
      "supported_providers": [
        "AWS S3",
        "MinIO (self-hosted)",
        "Cloudflare R2",
        "DigitalOcean Spaces",
        "Wasabi",
        "Any S3-compatible service"
      ]
    },
    "thumbnail_generation": {
      "description": "Automatic thumbnail extraction from videos",
      "settings": {
        "default_timestamp": 5.0,
        "default_width": 640,
        "format": "JPEG",
        "quality": 2
      }
    }
  },
  "architecture": {
    "layers": [
      {
        "name": "API Layer",
        "components": [
          "api/webrtc.py - WebRTC signaling endpoints",
          "api/recording.py - Recording control endpoints",
          "api/stream.py - Stream management endpoints"
        ]
      },
      {
        "name": "Service Layer",
        "components": [
          "services/recording.py - Recording lifecycle management",
          "services/storage.py - S3 upload and management",
          "services/encoding.py - Video transcoding",
          "services/stream.py - Stream session management"
        ]
      },
      {
        "name": "Library Layer",
        "components": [
          "lib/ffmpeg_utils.py - FFmpeg command builders",
          "lib/message_queue.py - RabbitMQ client"
        ]
      },
      {
        "name": "mediasoup Layer",
        "components": [
          "mediasoup/server.ts - WebRTC SFU implementation"
        ]
      }
    ],
    "data_flow": {
      "streaming": [
        "Client connects via WebRTC",
        "mediasoup handles media routing",
        "Media forwarded to other participants",
        "Optional recording to FFmpeg"
      ],
      "recording": [
        "FFmpeg captures RTMP/RTP stream",
        "Video encoded to MP4",
        "Multiple resolutions generated",
        "Upload to S3 storage",
        "Signed URLs returned to client"
      ]
    }
  },
  "api_endpoints": {
    "webrtc": {
      "base_path": "/api/v1/webrtc",
      "endpoints": [
        {
          "path": "/routers/{session_id}/capabilities",
          "method": "GET",
          "description": "Get router RTP capabilities",
          "response": {
            "rtp_capabilities": "object"
          }
        },
        {
          "path": "/transports",
          "method": "POST",
          "description": "Create WebRTC transport",
          "request": {
            "session_id": "string",
            "direction": "send|recv"
          },
          "response": {
            "transport_id": "string",
            "ice_parameters": "object",
            "ice_candidates": "array",
            "dtls_parameters": "object"
          }
        },
        {
          "path": "/transports/{transport_id}/connect",
          "method": "POST",
          "description": "Connect WebRTC transport",
          "request": {
            "dtls_parameters": "object"
          }
        },
        {
          "path": "/transports/{transport_id}/produce",
          "method": "POST",
          "description": "Create media producer",
          "request": {
            "kind": "audio|video",
            "rtp_parameters": "object"
          },
          "response": {
            "producer_id": "string"
          }
        },
        {
          "path": "/transports/{transport_id}/consume",
          "method": "POST",
          "description": "Create media consumer",
          "request": {
            "producer_id": "string",
            "rtp_capabilities": "object"
          },
          "response": {
            "consumer_id": "string",
            "rtp_parameters": "object"
          }
        },
        {
          "path": "/consumers/{consumer_id}/resume",
          "method": "POST",
          "description": "Resume paused consumer"
        },
        {
          "path": "/sessions/{session_id}",
          "method": "DELETE",
          "description": "Close session and cleanup"
        }
      ]
    },
    "recording": {
      "base_path": "/api/v1/recording",
      "endpoints": [
        {
          "path": "/start",
          "method": "POST",
          "description": "Start recording session",
          "request": {
            "session_id": "string (UUID)",
            "input_source": "string (RTMP/RTP URL)",
            "video_codec": "string (optional)",
            "audio_codec": "string (optional)"
          },
          "response": {
            "session_id": "string",
            "status": "recording",
            "started_at": "ISO 8601 timestamp",
            "output_path": "string"
          }
        },
        {
          "path": "/stop",
          "method": "POST",
          "description": "Stop recording and upload to S3",
          "request": {
            "session_id": "string (UUID)",
            "upload_to_s3": "boolean"
          },
          "response": {
            "session_id": "string",
            "status": "completed",
            "started_at": "ISO 8601 timestamp",
            "stopped_at": "ISO 8601 timestamp",
            "duration": "float (seconds)",
            "urls": [
              {
                "resolution": "240p|360p|480p|720p",
                "url": "string (signed URL)",
                "file_size": "integer (bytes)"
              }
            ],
            "thumbnail_url": "string (signed URL)"
          }
        },
        {
          "path": "/status/{session_id}",
          "method": "GET",
          "description": "Get recording status",
          "response": {
            "session_id": "string",
            "status": "recording|not_found",
            "is_recording": "boolean",
            "started_at": "ISO 8601 timestamp",
            "duration": "float (seconds)"
          }
        },
        {
          "path": "/list",
          "method": "GET",
          "description": "List active recordings",
          "response": {
            "active_recordings": "array",
            "count": "integer"
          }
        },
        {
          "path": "/metrics",
          "method": "GET",
          "description": "Get recording metrics",
          "response": {
            "active_recordings": "integer",
            "total_recordings_started": "integer",
            "total_recordings_completed": "integer",
            "total_recordings_failed": "integer"
          }
        },
        {
          "path": "/{session_id}",
          "method": "DELETE",
          "description": "Delete recording"
        }
      ]
    },
    "stream": {
      "base_path": "/api/v1/stream",
      "endpoints": [
        {
          "path": "/sessions",
          "method": "POST",
          "description": "Create stream session",
          "request": {
            "session_id": "string (UUID)",
            "interviewer_id": "string",
            "candidate_id": "string"
          },
          "response": {
            "session_id": "string",
            "is_active": "boolean",
            "participant_count": "integer"
          }
        },
        {
          "path": "/sessions/{session_id}",
          "method": "GET",
          "description": "Get session info"
        },
        {
          "path": "/sessions/{session_id}/start",
          "method": "POST",
          "description": "Start session"
        },
        {
          "path": "/sessions/{session_id}/end",
          "method": "POST",
          "description": "End session"
        },
        {
          "path": "/sessions/{session_id}/participants/add",
          "method": "POST",
          "description": "Add participant",
          "request": {
            "user_id": "string"
          }
        },
        {
          "path": "/sessions/{session_id}/participants/remove",
          "method": "POST",
          "description": "Remove participant",
          "request": {
            "user_id": "string"
          }
        },
        {
          "path": "/sessions",
          "method": "GET",
          "description": "List active sessions"
        },
        {
          "path": "/stats",
          "method": "GET",
          "description": "Get stream statistics"
        }
      ]
    }
  },
  "message_queue_integration": {
    "exchange": "video_processing",
    "exchange_type": "topic",
    "events": [
      {
        "routing_key": "recording.recording_started",
        "description": "Recording started",
        "payload": {
          "event": "recording_started",
          "session_id": "string",
          "timestamp": "ISO 8601",
          "data": {
            "started_at": "ISO 8601",
            "output_path": "string"
          }
        }
      },
      {
        "routing_key": "recording.recording_completed",
        "description": "Recording completed and uploaded",
        "payload": {
          "event": "recording_completed",
          "session_id": "string",
          "timestamp": "ISO 8601",
          "data": {
            "urls": "array",
            "thumbnail_url": "string",
            "duration": "float"
          }
        }
      },
      {
        "routing_key": "recording.recording_failed",
        "description": "Recording failed",
        "payload": {
          "event": "recording_failed",
          "session_id": "string",
          "timestamp": "ISO 8601",
          "data": {
            "error": "string"
          }
        }
      },
      {
        "routing_key": "stream.stream_started",
        "description": "Stream session started",
        "payload": {
          "event": "stream_started",
          "session_id": "string",
          "timestamp": "ISO 8601"
        }
      },
      {
        "routing_key": "stream.stream_ended",
        "description": "Stream session ended",
        "payload": {
          "event": "stream_ended",
          "session_id": "string",
          "timestamp": "ISO 8601"
        }
      }
    ]
  },
