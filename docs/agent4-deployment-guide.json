  "docker_build_instructions": {
    "build_all_images": {
      "description": "Build all Docker images for the platform",
      "commands": [
        "# Build backend services (Node.js)",
        "docker build -t blockd/api-gateway:latest ./backend/api-gateway",
        "docker build -t blockd/auth-service:latest ./backend/auth-service",
        "docker build -t blockd/session-service:latest ./backend/session-service",
        "",
        "# Build backend services (Python)",
        "docker build -t blockd/ai-detection:latest ./backend/ai-detection",
        "docker build -t blockd/eye-tracking:latest ./backend/eye-tracking",
        "docker build -t blockd/response-timing:latest ./backend/response-timing",
        "docker build -t blockd/video-service:latest ./backend/video-service",
        "",
        "# Build frontend",
        "docker build -t blockd/frontend:latest ./frontend/interviewer-app"
      ]
    },
    "build_single_service": {
      "description": "Build a single service",
      "example": "docker build -t blockd/api-gateway:latest ./backend/api-gateway"
    },
    "build_with_cache": {
      "description": "Build with Docker BuildKit for better caching",
      "commands": [
        "export DOCKER_BUILDKIT=1",
        "docker build -t blockd/api-gateway:latest ./backend/api-gateway"
      ]
    },
    "push_to_registry": {
      "description": "Tag and push images to container registry",
      "commands": [
        "# Tag images",
        "docker tag blockd/api-gateway:latest registry.blockd.com/api-gateway:1.0.0",
        "",
        "# Push to registry",
        "docker push registry.blockd.com/api-gateway:1.0.0"
      ]
    }
  },
  "local_development_setup": {
    "prerequisites": [
      "Docker 27.x or higher",
      "Docker Compose 2.x or higher",
      "At least 8GB RAM available for containers",
      "At least 20GB disk space"
    ],
    "steps": [
      {
        "step": 1,
        "description": "Clone the repository and navigate to project root",
        "command": "cd /path/to/Blockd"
      },
      {
        "step": 2,
        "description": "Create .env file with required API keys",
        "commands": [
          "cp .env.example .env",
          "# Edit .env and add:",
          "# OPENAI_API_KEY=your_key_here",
          "# ANTHROPIC_API_KEY=your_key_here",
          "# AWS_ACCESS_KEY_ID=your_key_here",
          "# AWS_SECRET_ACCESS_KEY=your_key_here"
        ]
      },
      {
        "step": 3,
        "description": "Start all services with docker-compose",
        "command": "docker-compose up -d"
      },
      {
        "step": 4,
        "description": "View logs",
        "commands": [
          "docker-compose logs -f",
          "docker-compose logs -f api-gateway",
          "docker-compose logs -f postgres"
        ]
      },
      {
        "step": 5,
        "description": "Access services",
        "urls": {
          "frontend": "http://localhost:5173",
          "api_gateway": "http://localhost:3000",
          "auth_service": "http://localhost:3001",
          "rabbitmq_management": "http://localhost:15672"
        }
      },
      {
        "step": 6,
        "description": "Stop all services",
        "command": "docker-compose down"
      },
      {
        "step": 7,
        "description": "Stop and remove volumes (clean slate)",
        "command": "docker-compose down -v"
      }
    ],
    "troubleshooting": {
      "port_conflicts": {
        "issue": "Port already in use",
        "solution": "Modify port mappings in docker-compose.yml or stop conflicting services"
      },
      "build_failures": {
        "issue": "Docker build fails",
        "solution": "Ensure all package.json and requirements.txt files exist, or remove build step from Dockerfiles"
      },
      "health_checks_failing": {
        "issue": "Services not becoming healthy",
        "solution": "Check logs with 'docker-compose logs [service-name]' and ensure dependencies are ready"
      }
    }
  },
  "kubernetes_deployment_guide": {
    "minikube_local_deployment": {
      "prerequisites": [
        "minikube installed",
        "kubectl installed",
        "helm installed",
        "At least 8GB RAM allocated to minikube"
      ],
      "steps": [
        {
          "step": 1,
          "description": "Start minikube",
          "command": "minikube start --memory=8192 --cpus=4"
        },
        {
          "step": 2,
          "description": "Enable ingress addon",
          "command": "minikube addons enable ingress"
        },
        {
          "step": 3,
          "description": "Build images and load into minikube",
          "commands": [
            "eval $(minikube docker-env)",
            "docker build -t blockd/api-gateway:latest ./backend/api-gateway",
            "# Repeat for all services..."
          ]
        },
        {
          "step": 4,
          "description": "Deploy using script",
          "command": "cd k8s/scripts && ./deploy.sh local install"
        },
        {
          "step": 5,
          "description": "Access services via minikube",
          "commands": [
            "minikube service frontend -n blockd",
            "minikube service api-gateway -n blockd"
          ]
        }
      ]
    },
    "staging_deployment": {
      "prerequisites": [
        "Access to staging Kubernetes cluster",
        "kubectl configured with staging context",
        "helm installed",
        "Container registry access"
      ],
      "steps": [
        {
          "step": 1,
          "description": "Build and push images to registry",
          "commands": [
            "docker build -t registry.staging.blockd.com/api-gateway:staging-latest ./backend/api-gateway",
            "docker push registry.staging.blockd.com/api-gateway:staging-latest",
            "# Repeat for all services..."
          ]
        },
        {
          "step": 2,
          "description": "Set kubectl context",
          "command": "kubectl config use-context blockd-staging"
        },
        {
          "step": 3,
          "description": "Create secrets (using external secret manager)",
          "command": "# Use AWS Secrets Manager, Vault, or kubectl create secret"
        },
        {
          "step": 4,
          "description": "Deploy using script",
          "command": "cd k8s/scripts && ./deploy.sh staging install"
        },
        {
          "step": 5,
          "description": "Verify deployment",
          "commands": [
            "kubectl get pods -n blockd-staging",
            "kubectl get svc -n blockd-staging",
            "kubectl get ingress -n blockd-staging"
          ]
        }
      ]
    },
    "production_deployment": {
      "prerequisites": [
        "Access to production Kubernetes cluster",
        "kubectl configured with production context",
        "helm installed",
        "Container registry with versioned images",
        "External secret manager configured (AWS Secrets Manager, Vault, etc.)",
        "TLS certificates configured",
        "DNS configured"
      ],
      "steps": [
        {
          "step": 1,
          "description": "Build and push versioned images",
          "commands": [
            "docker build -t registry.blockd.com/api-gateway:1.0.0 ./backend/api-gateway",
            "docker push registry.blockd.com/api-gateway:1.0.0",
            "# Repeat for all services with same version tag"
          ]
        },
        {
          "step": 2,
          "description": "Set kubectl context",
          "command": "kubectl config use-context blockd-production"
        },
        {
          "step": 3,
          "description": "Configure external secrets",
          "note": "Use AWS Secrets Manager, Vault, or Sealed Secrets - never commit secrets to git"
        },
        {
          "step": 4,
          "description": "Update values-production.yaml with correct image tags",
          "command": "# Edit k8s/helm/blockd/values-production.yaml"
        },
        {
          "step": 5,
          "description": "Deploy using script",
          "command": "cd k8s/scripts && ./deploy.sh production install"
        },
        {
          "step": 6,
          "description": "Verify deployment and monitor",
          "commands": [
            "kubectl get pods -n blockd",
            "kubectl get svc -n blockd",
            "kubectl get ingress -n blockd",
            "kubectl logs -n blockd -l app=api-gateway -f"
          ]
        }
      ],
      "rollback": {
        "description": "Rollback to previous version",
        "commands": [
          "helm rollback blockd -n blockd",
          "# Or rollback to specific revision:",
          "helm rollback blockd 2 -n blockd"
        ]
      }
    }
  },
  "service_discovery": {
    "internal_dns": {
      "description": "Services communicate using Kubernetes DNS",
      "format": "<service-name>.<namespace>.svc.cluster.local",
      "examples": {
        "api_gateway": "api-gateway.blockd.svc.cluster.local:3000",
        "auth_service": "auth-service.blockd.svc.cluster.local:3001",
        "postgres": "postgres.blockd.svc.cluster.local:5432",
        "redis": "redis.blockd.svc.cluster.local:6379",
        "rabbitmq": "rabbitmq.blockd.svc.cluster.local:5672"
      }
    },
    "short_names": {
      "description": "Within the same namespace, use short service names",
      "examples": {
        "api_gateway": "http://api-gateway:3000",
        "auth_service": "http://auth-service:3001",
        "postgres": "postgres:5432"
      }
    },
    "environment_variables": {
      "description": "Services discover each other via environment variables",
      "examples": {
        "DATABASE_URL": "postgresql://user:pass@postgres:5432/blockd",
        "REDIS_URL": "redis://:password@redis:6379",
        "RABBITMQ_URL": "amqp://user:pass@rabbitmq:5672/blockd",
        "AUTH_SERVICE_URL": "http://auth-service:3001",
        "SESSION_SERVICE_URL": "http://session-service:3002"
      }
    }
  },
  "scaling_strategies": {
    "horizontal_pod_autoscaler": {
      "description": "HPA automatically scales pods based on CPU/memory metrics",
      "configured_services": [
        {
          "service": "api-gateway",
          "min_replicas": 3,
          "max_replicas": 10,
          "cpu_threshold": "70%",
          "memory_threshold": "80%"
        },
        {
          "service": "ai-detection",
          "min_replicas": 3,
          "max_replicas": 10,
          "cpu_threshold": "70%",
          "memory_threshold": "80%"
        },
        {
          "service": "frontend",
          "min_replicas": 3,
          "max_replicas": 10,
          "cpu_threshold": "70%",
          "memory_threshold": "80%"
        }
      ]
    },
    "manual_scaling": {
      "description": "Manually scale deployments using kubectl",
      "commands": [
        "# Scale up",
        "kubectl scale deployment api-gateway --replicas=5 -n blockd",
        "",
        "# Scale down",
        "kubectl scale deployment api-gateway --replicas=2 -n blockd"
      ]
    },
    "statefulset_scaling": {
      "description": "Scale StatefulSets for databases",
      "commands": [
        "# Scale Redis cluster",
        "kubectl scale statefulset redis --replicas=5 -n blockd",
        "",
        "# Scale RabbitMQ cluster",
        "kubectl scale statefulset rabbitmq --replicas=5 -n blockd"
      ],
      "note": "PostgreSQL should remain at 1 replica unless setting up replication"
    }
  },
