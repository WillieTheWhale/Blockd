          "file": "namespace.yaml",
          "description": "Creates blockd namespace with labels"
        },
        {
          "file": "configmap.yaml",
          "description": "Application configuration (non-sensitive)"
        },
        {
          "file": "secrets.yaml",
          "description": "TEMPLATE for secrets - use external secret manager in production"
        },
        {
          "file": "postgres-deployment.yaml",
          "type": "StatefulSet",
          "replicas": 1,
          "storage": "20Gi",
          "resources": {
            "requests": {"memory": "1Gi", "cpu": "500m"},
            "limits": {"memory": "2Gi", "cpu": "1000m"}
          }
        },
        {
          "file": "redis-deployment.yaml",
          "type": "StatefulSet",
          "replicas": 3,
          "storage": "5Gi",
          "resources": {
            "requests": {"memory": "256Mi", "cpu": "250m"},
            "limits": {"memory": "512Mi", "cpu": "500m"}
          }
        },
        {
          "file": "rabbitmq-deployment.yaml",
          "type": "StatefulSet",
          "replicas": 3,
          "storage": "10Gi",
          "resources": {
            "requests": {"memory": "512Mi", "cpu": "250m"},
            "limits": {"memory": "1Gi", "cpu": "500m"}
          }
        },
        {
