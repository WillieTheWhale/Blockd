{
  "agent": 4,
  "name": "Docker & Kubernetes Infrastructure",
  "version": "1.0.0",
  "created": "2025-11-24",
  "overview": {
    "description": "Complete Docker and Kubernetes infrastructure for the Blockd platform, including Dockerfiles, docker-compose for local development, Kubernetes manifests, and Helm charts for production deployment.",
    "technologies": {
      "docker": "27.x",
      "kubernetes": "1.31",
      "helm": "3.x",
      "nodejs": "24.11.0",
      "python": "3.14.0",
      "postgres": "18.1",
      "redis": "8.4",
      "rabbitmq": "4.x"
    }
  },
  "deliverables": {
    "dockerfiles": {
      "description": "Production-ready multi-stage Dockerfiles for all services",
      "files": [
        {
          "path": "/backend/api-gateway/Dockerfile",
          "base_image": "node:24.11.0-alpine",
          "type": "multi-stage",
          "port": 3000,
          "features": ["non-root user", "health check", "layer caching"]
        },
        {
          "path": "/backend/auth-service/Dockerfile",
          "base_image": "node:24.11.0-alpine",
          "type": "multi-stage",
          "port": 3001,
          "features": ["non-root user", "health check", "layer caching"]
        },
        {
          "path": "/backend/session-service/Dockerfile",
          "base_image": "node:24.11.0-alpine",
          "type": "multi-stage",
          "port": 3002,
          "features": ["non-root user", "health check", "layer caching"]
        },
        {
          "path": "/backend/ai-detection/Dockerfile",
          "base_image": "python:3.14.0-slim",
          "type": "multi-stage",
          "port": 8000,
          "features": ["non-root user", "health check", "optimized dependencies"]
        },
        {
          "path": "/backend/eye-tracking/Dockerfile",
          "base_image": "python:3.14.0-slim",
          "type": "multi-stage",
          "port": 8001,
          "features": ["non-root user", "health check", "OpenCV runtime dependencies"]
        },
        {
          "path": "/backend/response-timing/Dockerfile",
          "base_image": "python:3.14.0-slim",
          "type": "multi-stage",
          "port": 8002,
          "features": ["non-root user", "health check", "optimized dependencies"]
        },
        {
          "path": "/backend/video-service/Dockerfile",
          "base_image": "python:3.14.0-slim",
          "type": "multi-stage",
          "port": 8003,
          "features": ["non-root user", "health check", "FFmpeg 7.x", "video storage volumes"]
        },
        {
          "path": "/frontend/interviewer-app/Dockerfile",
          "base_image": "node:24.11.0-alpine (builder), nginx:1.27-alpine (runtime)",
          "type": "multi-stage",
          "port": 80,
          "features": ["Vite build", "nginx static hosting", "API proxy configuration"]
        }
      ]
    },
    "docker_compose": {
      "path": "/docker-compose.yml",
      "description": "Complete local development environment with all services",
      "services": {
        "infrastructure": [
          {
            "name": "postgres",
            "image": "postgres:18.1-alpine",
            "port": 5432,
            "volumes": ["postgres_data"],
            "health_check": true
          },
          {
            "name": "redis",
            "image": "redis:8.4-alpine",
            "port": 6379,
            "volumes": ["redis_data"],
            "health_check": true
          },
          {
            "name": "rabbitmq",
            "image": "rabbitmq:4-management-alpine",
            "ports": [5672, 15672],
            "volumes": ["rabbitmq_data"],
            "health_check": true
          }
        ],
        "backend": [
          {
            "name": "api-gateway",
            "build": "./backend/api-gateway",
            "port": 3000,
            "depends_on": ["postgres", "redis", "rabbitmq"]
          },
          {
            "name": "auth-service",
            "build": "./backend/auth-service",
            "port": 3001,
            "depends_on": ["postgres", "redis"]
          },
          {
            "name": "session-service",
            "build": "./backend/session-service",
            "port": 3002,
            "depends_on": ["postgres", "redis", "rabbitmq"]
          },
          {
            "name": "ai-detection",
            "build": "./backend/ai-detection",
            "port": 8000,
            "depends_on": ["postgres", "redis", "rabbitmq"]
          },
          {
            "name": "eye-tracking",
            "build": "./backend/eye-tracking",
            "port": 8001,
            "depends_on": ["postgres", "rabbitmq"]
          },
          {
            "name": "response-timing",
            "build": "./backend/response-timing",
            "port": 8002,
            "depends_on": ["postgres", "rabbitmq"]
          },
          {
            "name": "video-service",
            "build": "./backend/video-service",
            "port": 8003,
            "depends_on": ["postgres", "rabbitmq"]
          }
        ],
        "frontend": [
          {
            "name": "frontend",
            "build": "./frontend/interviewer-app",
            "port": 5173,
            "depends_on": ["api-gateway"]
          }
        ]
      },
      "networks": ["blockd-network"],
      "volumes": ["postgres_data", "redis_data", "rabbitmq_data", "ai_models", "eye_tracking_models", "video_recordings"]
    },
    "kubernetes_manifests": {
      "path": "/k8s/manifests/",
      "description": "Production-ready Kubernetes manifests for all services",
      "files": [
