          "file": "video-service-deployment.yaml",
          "type": "Deployment",
          "replicas": 2,
          "resources": {
            "requests": {"memory": "1Gi", "cpu": "500m"},
            "limits": {"memory": "2Gi", "cpu": "1000m"}
          }
        },
        {
          "file": "frontend-deployment.yaml",
          "type": "Deployment + HPA",
          "replicas": 3,
          "autoscaling": {"min": 3, "max": 10, "cpu_threshold": 70},
          "resources": {
