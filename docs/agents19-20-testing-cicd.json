      "✅ Check error rates",
      "✅ Test critical user flows",
      "✅ Update documentation",
      "✅ Notify stakeholders",
      "✅ Close deployment ticket"
    ]
  },

  "runbooks": {
    "location": "/docs/runbooks/",
    "documents": [
      "incident-response.md - How to respond to outages",
      "rollback-procedure.md - How to rollback a deployment",
      "database-restore.md - How to restore from backup",
      "scaling-guide.md - How to manually scale services",
      "monitoring-alerts.md - How to interpret and respond to alerts",
      "security-incident.md - Security incident response"
    ]
  }
}
