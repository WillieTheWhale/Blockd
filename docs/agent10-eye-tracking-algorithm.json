  "integration_points": {
    "database": {
      "type": "PostgreSQL with TimescaleDB extension",
      "tables": [
        "gaze_events (hypertable, partitioned by timestamp)",
        "gaze_sessions",
        "gaze_summaries",
        "gaze_anomalies"
      ],
      "retention": "90 days for raw events, indefinite for summaries"
    },
    "message_queue": {
      "type": "RabbitMQ",
      "queues": [
        "gaze_processing_queue",
        "gaze_events_exchange"
      ],
      "use_case": "Async processing and inter-service communication"
    },
    "websocket_service": {
      "url": "ws://websocket-service:8005",
      "purpose": "Real-time gaze data streaming to frontend"
    },
