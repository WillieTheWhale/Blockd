{
  "agent": "Agent 7",
  "role": "Session Management Developer",
  "service": "session-service",
  "version": "1.0.0",
  "date": "2025-11-24",
  "description": "Complete session lifecycle documentation for the Blockd platform",

  "state_machine": {
    "description": "Session state machine defining all possible state transitions",
    "states": [
      {
        "name": "scheduled",
        "description": "Session is created and waiting to start",
        "is_terminal": false
      },
      {
        "name": "active",
        "description": "Session is currently in progress",
        "is_terminal": false
      },
      {
        "name": "ended",
        "description": "Session completed normally",
        "is_terminal": true
      },
      {
        "name": "cancelled",
        "description": "Session was cancelled before or during execution",
        "is_terminal": true
      }
    ],
    "transitions": [
      {
        "from": "scheduled",
        "to": "active",
        "event": "start",
        "description": "Interviewer starts the scheduled session",
        "validation": [
          "Session must be in scheduled state",
          "Current time should be within scheduled window",
          "At least one question must be defined"
        ],
        "side_effects": [
          "Set actual_start timestamp",
          "Start video recording via message queue",
          "Broadcast session.started event via WebSocket",
          "Create audit log entry"
        ]
      },
      {
        "from": "scheduled",
        "to": "cancelled",
        "event": "cancel",
        "description": "Session cancelled before starting",
        "validation": [
          "Session must be in scheduled state",
          "Cancellation reason should be provided"
        ],
        "side_effects": [
          "Set cancellation metadata",
          "Broadcast session.cancelled event",
          "Send notification to participants",
          "Create audit log entry"
        ]
      },
      {
        "from": "active",
        "to": "ended",
        "event": "end",
        "description": "Interviewer ends the active session",
        "validation": [
          "Session must be in active state",
          "Session has been running for at least 1 minute"
        ],
        "side_effects": [
          "Set actual_end timestamp",
          "Calculate session duration",
          "Stop video recording via message queue",
          "Generate session report",
          "Calculate final risk score",
          "Send report email to interviewer",
          "Broadcast session.ended event",
          "Clear participant cache",
          "Create audit log entry"
        ]
      },
      {
        "from": "active",
        "to": "cancelled",
        "event": "cancel",
        "description": "Session cancelled while in progress",
        "validation": [
          "Session must be in active state",
          "Cancellation reason must be provided"
        ],
        "side_effects": [
          "Stop video recording",
          "Set cancellation metadata",
          "Broadcast session.cancelled event",
          "Clear participant cache",
          "Create audit log entry"
        ]
      }
    ],
    "diagram": {
      "mermaid": "stateDiagram-v2\n    [*] --> scheduled\n    scheduled --> active: start\n    scheduled --> cancelled: cancel\n    active --> ended: end\n    active --> cancelled: cancel\n    ended --> [*]\n    cancelled --> [*]"
    }
  },

  "session_creation_flow": {
    "description": "Step-by-step flow for creating a new interview session",
    "steps": [
      {
        "step": 1,
        "action": "Validate input",
        "details": {
          "required_fields": [
            "scheduled_start (ISO8601 datetime)",
            "duration_minutes (positive integer, max 240)",
            "questions (array, min 1 question)"
          ],
          "optional_fields": [
            "interviewee_id (UUID)",
            "interviewee_email (email)",
            "metadata (object)"
          ],
          "validation_rules": [
            "Either interviewee_id OR interviewee_email must be provided",
            "scheduled_start must be in the future",
            "duration_minutes must be <= MAX_SESSION_DURATION_HOURS * 60",
            "Each question must have question_text"
          ]
        }
      },
      {
        "step": 2,
        "action": "Verify interviewer permissions",
        "details": {
          "checks": [
            "Interviewer exists in database",
            "Interviewer belongs to an organization",
            "Organization has not exceeded session limits",
            "Interviewer has 'interviewer' or 'admin' role"
          ]
        }
      },
      {
        "step": 3,
        "action": "Create session in database",
        "details": {
          "transaction": true,
          "operations": [
            "INSERT INTO interview_sessions",
            "INSERT multiple rows INTO questions (one per question in array)",
            "PostgreSQL trigger generates session_token automatically"
          ],
          "initial_state": "scheduled"
        }
      },
      {
        "step": 4,
        "action": "Generate and store session token",
        "details": {
          "token_generation": "nanoid(64) - cryptographically secure",
          "storage": "Redis with key: token:{token}, value: session_id",
          "ttl": "24 hours (86400 seconds)",
          "purpose": "Allow interviewee to join session via join URL"
        }
      },
      {
        "step": 5,
        "action": "Cache session data",
        "details": {
          "cache_key": "session:{session_id}",
          "cached_data": {
            "session_id": "UUID",
            "status": "scheduled",
            "interviewer_id": "UUID",
            "interviewee_id": "UUID or null",
            "scheduled_start": "ISO8601",
            "metadata": "object"
          },
          "ttl": "Same as token TTL"
        }
      },
      {
        "step": 6,
        "action": "Send invitation email",
        "details": {
          "recipient": "interviewee_email",
          "template": "session-invitation",
          "data": {
            "join_url": "FRONTEND_URL/session/join/{session_token}",
            "scheduled_start": "formatted datetime",
            "interviewer_name": "interviewer full name",
            "organization_name": "organization name"
          },
          "delivery": "Async via notification service"
        }
      },
      {
        "step": 7,
        "action": "Return response to client",
        "details": {
          "status_code": 201,
          "response_body": {
            "session_id": "UUID",
            "session_token": "64-char token",
            "status": "scheduled",
            "join_url": "Full URL for interviewee",
            "websocket_url": "WebSocket connection URL",
            "interviewer": "UserInfo object",
            "scheduled_start": "ISO8601",
            "created_at": "ISO8601"
          }
        }
      }
    ]
  },

  "session_start_flow": {
    "description": "Flow for starting a scheduled session",
    "steps": [
      {
        "step": 1,
        "action": "Validate session state",
        "checks": [
          "Session exists",
          "Session status is 'scheduled'",
          "State machine allows transition to 'active'"
        ]
      },
      {
        "step": 2,
        "action": "Update session to active",
        "database_updates": {
          "status": "active",
          "actual_start": "NOW()"
        }
      },
      {
        "step": 3,
        "action": "Start video recording",
        "message_queue": {
          "exchange": "video_processing",
          "routing_key": "video.start",
          "payload": {
            "session_id": "UUID",
            "interviewer_id": "UUID",
            "interviewee_id": "UUID",
            "metadata": "object"
          }
        }
      },
      {
        "step": 4,
        "action": "Broadcast session started event",
        "websocket": {
          "event": "session.started",
          "room": "session:{session_id}",
          "payload": {
            "session_id": "UUID",
            "status": "active",
            "started_at": "ISO8601",
            "participants": "array of connected participants"
          }
        }
      },
      {
        "step": 5,
        "action": "Create audit log",
        "log_entry": {
          "action": "session.start",
          "resource_type": "interview_session",
          "resource_id": "session_id",
          "user_id": "started_by",
          "metadata": {
            "previous_status": "scheduled",
            "new_status": "active"
          }
        }
      }
    ]
  },

  "session_end_flow": {
    "description": "Flow for ending an active session",
    "steps": [
      {
        "step": 1,
        "action": "Validate session state",
        "checks": [
          "Session exists",
          "Session status is 'active'",
          "State machine allows transition to 'ended'"
        ]
      },
      {
        "step": 2,
        "action": "Calculate duration and update session",
        "database_updates": {
          "status": "ended",
          "actual_end": "NOW()",
          "duration_minutes": "Calculated from actual_start to actual_end"
        }
      },
      {
        "step": 3,
        "action": "Stop video recording",
        "message_queue": {
          "exchange": "video_processing",
          "routing_key": "video.stop",
          "payload": {
            "session_id": "UUID",
            "duration_seconds": "calculated duration"
          }
        }
      },
      {
        "step": 4,
        "action": "Generate session report",
        "process": {
          "description": "Comprehensive analysis of session data",
          "data_sources": [
            "All questions and answers",
            "AI detection results from answer_analysis table",
            "Security events from security_events table",
            "Gaze tracking data from gaze_events table",
            "Browser telemetry from browser_telemetry table"
          ],
          "calculations": [
            "Overall risk score (weighted average)",
            "AI detection score (max similarity across all answers)",
            "Security events score (severity-weighted)",
            "Gaze anomaly score (off-screen percentage)",
            "Timing anomaly score (response latency patterns)"
          ],
          "outputs": [
            "Comprehensive SessionReport object",
            "Recommendations array",
            "Overall assessment (pass/review_required/fail)",
            "Flagged answers and behaviors"
          ],
          "storage": "INSERT INTO session_reports"
        }
      },
      {
        "step": 5,
        "action": "Send report email",
        "email": {
          "recipient": "interviewer email",
          "subject": "Interview Report - {organization_name}",
          "template": "session-report",
          "attachments": [
            "PDF report (if enabled)"
          ]
        }
      },
      {
        "step": 6,
        "action": "Broadcast session ended event",
        "websocket": {
          "event": "session.ended",
          "room": "session:{session_id}",
          "payload": {
            "session_id": "UUID",
            "status": "ended",
            "ended_at": "ISO8601",
            "duration_seconds": "number",
            "reason": "string or null"
          }
        }
      },
      {
        "step": 7,
        "action": "Clear participant cache",
        "redis_operations": [
          "DELETE participants:{session_id}"
        ]
      }
    ]
  },

  "security_event_handling": {
    "description": "How security events are logged and processed",
    "event_types": [
      {
        "type": "suspicious_process",
        "severity": "high",
        "description": "Unauthorized process detected (e.g., TeamViewer, AnyDesk)",
        "action": "Log event, increment risk score, alert interviewer"
      },
      {
        "type": "screen_recording_detected",
        "severity": "critical",
        "description": "Screen recording software detected (e.g., OBS, Camtasia)",
        "action": "Log event, increment risk score, alert interviewer, flag session"
      },
      {
        "type": "vm_detected",
        "severity": "high",
        "description": "Virtual machine detected",
        "action": "Log event, increment risk score, alert interviewer"
      },
      {
        "type": "window_focus_changed",
        "severity": "low",
        "description": "Browser window lost focus",
        "action": "Log event, track frequency"
      },
      {
        "type": "multi_monitor_detected",
        "severity": "medium",
        "description": "Multiple monitors detected",
        "action": "Log event, increase gaze monitoring"
      },
      {
        "type": "unauthorized_browser",
        "severity": "critical",
        "description": "Non-Chromium browser detected",
        "action": "Block access, terminate session"
      },
      {
        "type": "copy_paste_detected",
        "severity": "medium",
        "description": "Clipboard activity detected",
        "action": "Log event, increment risk score"
      },
      {
        "type": "keyboard_shortcut_blocked",
        "severity": "low",
        "description": "Attempted to use blocked keyboard shortcut",
        "action": "Log event, track attempts"
      }
    ],
    "processing_flow": [
      {
        "step": 1,
        "action": "Receive security event",
        "source": "Chromium extension via API"
      },
      {
        "step": 2,
        "action": "Validate and store",
        "database": "INSERT INTO security_events",
        "fields": {
          "session_id": "UUID",
          "event_type": "enum",
          "severity": "enum (low, medium, high, critical)",
          "description": "string",
          "metadata": "JSONB",
          "timestamp": "NOW()"
        }
      },
      {
        "step": 3,
        "action": "Publish to message queue",
        "exchange": "security_events",
        "routing_key": "security.{severity}",
        "consumers": [
          "Alert service",
          "Analytics service",
          "Audit logging service"
        ]
      },
      {
        "step": 4,
        "action": "Update session risk score",
        "condition": "If severity is 'high' or 'critical'",
        "calculation": {
          "formula": "weighted_sum(events) / max_possible_score",
          "weights": {
            "low": 0.1,
            "medium": 0.3,
            "high": 0.6,
            "critical": 1.0
          },
          "normalization": "min(1.0, total_risk / 10)"
        }
      },
      {
        "step": 5,
        "action": "Broadcast to interviewer",
        "websocket": {
          "event": "security.alert",
          "room": "session:{session_id}",
          "target": "interviewer only",
          "payload": {
            "event_id": "UUID",
            "event_type": "string",
            "severity": "string",
            "description": "string",
            "timestamp": "ISO8601",
            "requires_action": "boolean"
          }
        }
      }
    ]
  },

  "report_generation": {
    "description": "Comprehensive session report generation",
    "trigger_events": [
      "Session ended normally",
      "Manual report generation requested",
      "Scheduled report generation (for active sessions)"
    ],
    "data_collection": {
      "session_metadata": {
        "source": "interview_sessions table",
        "fields": [
          "session_id",
          "status",
          "scheduled_start",
          "actual_start",
          "actual_end",
          "duration_minutes",
          "organization"
        ]
      },
      "participants": {
        "source": "users table (via foreign keys)",
        "fields": [
          "interviewer (full_name, email, role)",
          "interviewee (full_name, email, role)"
        ]
      },
      "questions_and_answers": {
        "source": "questions + answer_analysis tables",
        "fields": [
          "question_text",
          "difficulty",
          "expected_duration_seconds",
          "asked_at",
          "answer_text",
          "risk_score",
          "is_ai_generated",
          "confidence_score",
          "ai_similarity_scores (per model)",
          "response_timing (latency, wpm, pauses)",
          "perplexity_score"
        ]
      },
      "security_events": {
        "source": "security_events table",
        "aggregations": [
          "Total count",
          "Count by severity (low, medium, high, critical)",
          "Count by type",
          "Timeline (chronological list)",
          "Critical events (filtered list)"
        ]
      },
      "gaze_tracking": {
        "source": "gaze_events table (TimescaleDB hypertable)",
        "aggregations": [
          "Total gaze events",
          "Off-screen events count",
          "Off-screen percentage",
          "Off-screen duration (seconds)",
          "Off-screen by direction (left, right, up, down)",
          "Anomaly score",
          "Suspicious patterns"
        ]
      },
      "timing_analysis": {
        "source": "answer_analysis.response_timing (JSONB)",
        "aggregations": [
          "Average response latency (ms)",
          "Average words per minute",
          "Average pause count",
          "Average filler ratio",
          "Unusually fast responses count",
          "Unusually slow responses count",
          "Anomaly score"
        ]
      }
    },
    "risk_calculation": {
      "overall_risk_score": {
        "formula": "weighted_average(component_scores)",
        "components": [
          {
            "name": "ai_detection_score",
            "weight": 0.40,
            "calculation": "max(answer_risk_scores)"
          },
          {
            "name": "security_events_score",
            "weight": 0.30,
            "calculation": "weighted_sum(events) / max_possible"
          },
          {
            "name": "gaze_anomaly_score",
            "weight": 0.20,
            "calculation": "(off_screen_percentage + off_screen_time_ratio) / 2"
          },
          {
            "name": "timing_anomaly_score",
            "weight": 0.10,
            "calculation": "anomaly_ratio(fast_responses, slow_responses, filler_ratio)"
          }
        ],
        "thresholds": {
          "low": "< 0.50",
          "medium": "0.50 - 0.74",
          "high": "0.75 - 0.89",
          "critical": ">= 0.90"
        }
      }
    },
    "recommendations": {
      "generation_rules": [
        {
          "condition": "risk_level == 'critical' OR risk_level == 'high'",
          "recommendation": {
            "type": "action",
            "category": "integrity",
            "title": "Manual Review Required",
            "severity": "critical",
            "action_required": true
          }
        },
        {
          "condition": "security_events.critical > 0",
          "recommendation": {
            "type": "warning",
            "category": "security",
            "title": "Critical Security Events Detected",
            "severity": "critical",
            "action_required": true
          }
        },
        {
          "condition": "ai_detection_score > 0.75",
          "recommendation": {
            "type": "warning",
            "category": "integrity",
            "title": "Possible AI-Generated Answers",
            "severity": "high",
            "action_required": true
          }
        },
        {
          "condition": "gaze_anomaly_score > 0.70",
          "recommendation": {
            "type": "warning",
            "category": "integrity",
            "title": "Excessive Off-Screen Activity",
            "severity": "medium",
            "action_required": false
          }
        }
      ]
    },
    "overall_assessment": {
      "verdict_logic": {
        "fail": "risk_level == 'critical' OR critical_recommendations > 0",
        "review_required": "risk_level == 'high' OR high_recommendations > 0",
        "pass": "Otherwise"
      },
      "confidence_calculation": "Based on data completeness and consistency"
    },
    "output_formats": [
      {
        "format": "JSON",
        "mime_type": "application/json",
        "use_case": "API responses, data export, analytics"
      },
      {
        "format": "PDF",
        "mime_type": "application/pdf",
        "library": "pdfkit",
        "sections": [
          "Cover page with risk level badge",
          "Session information",
          "Overall assessment",
          "Risk analysis with component scores",
          "Security summary",
          "Questions and answers",
          "Gaze tracking analysis (if available)",
          "Timing analysis (if available)",
          "Recommendations"
        ],
        "use_case": "Email attachments, archival, presentation"
      }
    ]
  },

  "websocket_specifications": {
    "connection": {
      "url": "ws://localhost:3003",
      "authentication": {
        "method": "JWT token",
        "location": "handshake.auth.token or handshake.query.token",
        "validation": "JWT verified against JWT_SECRET",
        "payload": {
          "user_id": "UUID",
          "role": "interviewer or interviewee",
          "session_id": "UUID (optional)"
        }
      },
      "lifecycle": [
        "Client connects with JWT token",
        "Server validates token (authenticateSocket middleware)",
        "Server attaches user_id and session_id to socket",
        "Client emits 'join' event with session_id",
        "Server adds socket to session room",
        "Server tracks participant in Redis",
        "Server broadcasts 'participant.joined' to room",
        "Client receives 'authenticated' confirmation"
      ]
    },
    "client_to_server_events": [
      {
        "event": "join",
        "payload": {
          "session_id": "UUID",
          "user_id": "UUID",
          "token": "JWT token"
        },
        "response": "authenticated event or error event",
        "side_effects": [
          "Socket joins session room",
          "Participant added to Redis cache",
          "Broadcast participant.joined to room"
        ]
      },
      {
        "event": "leave",
        "payload": {
          "session_id": "UUID",
          "user_id": "UUID"
        },
        "side_effects": [
          "Socket leaves session room",
          "Participant marked as disconnected in Redis",
          "Broadcast participant.left to room"
        ]
      },
      {
        "event": "ping",
        "payload": {},
        "response": "pong event with timestamp"
      },
      {
        "event": "answer.submit",
        "payload": {
          "session_id": "UUID",
          "question_id": "UUID",
          "answer_text": "string",
          "user_id": "UUID"
        },
        "side_effects": [
          "Answer saved to database",
          "AI detection job queued",
          "Broadcast answer.submitted to room"
        ]
      }
    ],
    "server_to_client_events": [
      {
        "event": "session.created",
        "payload": {
          "session_id": "UUID",
          "status": "scheduled",
          "interviewer": "UserInfo",
          "scheduled_start": "ISO8601"
        },
        "broadcast_to": "All connected clients (optional)"
      },
      {
        "event": "session.started",
        "payload": {
          "session_id": "UUID",
          "status": "active",
          "started_at": "ISO8601",
          "participants": "array"
        },
        "broadcast_to": "Session room"
      },
      {
        "event": "session.ended",
        "payload": {
          "session_id": "UUID",
          "status": "ended",
          "ended_at": "ISO8601",
          "duration_seconds": "number"
        },
        "broadcast_to": "Session room"
      },
      {
        "event": "participant.joined",
        "payload": {
          "session_id": "UUID",
          "user_id": "UUID",
          "role": "interviewer or interviewee",
          "full_name": "string",
          "joined_at": "ISO8601"
        },
        "broadcast_to": "Session room"
      },
      {
        "event": "security.alert",
        "payload": {
          "session_id": "UUID",
          "event": "SecurityEventDetail",
          "requires_action": "boolean"
        },
        "broadcast_to": "Interviewer only"
      },
      {
        "event": "answer.submitted",
        "payload": {
          "session_id": "UUID",
          "question_id": "UUID",
          "answer_id": "UUID",
          "submitted_by": "UUID",
          "submitted_at": "ISO8601"
        },
        "broadcast_to": "Session room"
      },
      {
        "event": "error",
        "payload": {
          "error_code": "string",
          "message": "string",
          "details": "object (optional)"
        },
        "broadcast_to": "Individual socket"
      }
    ],
    "room_management": {
      "room_naming": "session:{session_id}",
      "join": "Socket.io socket.join(room)",
      "leave": "Socket.io socket.leave(room)",
      "broadcast": "io.to(room).emit(event, data)",
      "tracking": "Map<session_id, Set<socket_id>> in memory"
    },
    "heartbeat": {
      "ping_interval": "25000ms (25 seconds)",
      "ping_timeout": "60000ms (60 seconds)",
      "client_pings": "Client sends 'ping' event",
      "server_pongs": "Server responds with 'pong' event + timestamp"
    }
  },

  "redis_cache_strategy": {
    "keys": [
      {
        "pattern": "session:{session_id}",
        "type": "string (JSON)",
        "ttl": "SESSION_TOKEN_TTL (24 hours)",
        "data": {
          "session_id": "UUID",
          "status": "SessionStatus",
          "interviewer_id": "UUID",
          "interviewee_id": "UUID or null",
          "scheduled_start": "ISO8601",
          "metadata": "object"
        },
        "purpose": "Fast session state lookup without database query"
      },
      {
        "pattern": "token:{session_token}",
        "type": "string",
        "ttl": "SESSION_TOKEN_TTL (24 hours)",
        "data": "session_id (UUID)",
        "purpose": "Validate session token and get session ID"
      },
      {
        "pattern": "participants:{session_id}",
        "type": "hash",
        "ttl": "No TTL (cleared on session end)",
        "data": "Hash of user_id → SessionParticipant JSON",
        "purpose": "Track connected participants in real-time"
      },
      {
        "pattern": "active_sessions:{interviewer_id}",
        "type": "set",
        "ttl": "No TTL (updated on status change)",
        "data": "Set of session_id UUIDs",
        "purpose": "Quick lookup of interviewer's active sessions"
      }
    ],
    "cache_invalidation": {
      "on_session_end": [
        "DELETE participants:{session_id}",
        "UPDATE session:{session_id} with final status",
        "SREM active_sessions:{interviewer_id} {session_id}"
      ],
      "on_session_cancel": [
        "DELETE participants:{session_id}",
        "UPDATE session:{session_id} with cancelled status",
        "SREM active_sessions:{interviewer_id} {session_id}"
      ],
      "on_token_use": [
        "Extend TTL of token:{token} by SESSION_TOKEN_TTL"
      ]
    }
  },

