{
  "agents": [16, 17, 18],
  "phase": 5,
  "status": "architectural_specification",
  "implementation_scope": "Requires dedicated Chromium build environment (50+ GB, 16+ GB RAM, several hours compilation time)",
  "deployment_note": "Chromium browser compilation and distribution is beyond MVP scope but fully specified for future implementation",

  "agent_16": {
    "name": "Chromium Browser Architect",
    "chromium_version": "142.0.7444.175 (stable branch)",
    "build_system": {
      "tools": ["GN", "Ninja", "depot_tools"],
      "requirements": {
        "disk_space": "100+ GB",
        "ram": "16-32 GB",
        "cpu_cores": "8+",
        "build_time": "4-8 hours (initial), 20-60 min (incremental)"
      }
    },

    "browser_modifications": {
      "new_modules": [
        {
          "path": "chrome/browser/blocked_security/",
          "files": [
            "blocked_security_service.h",
            "blocked_security_service.cc",
            "blocked_security_observer.h",
            "blocked_security_observer.cc",
            "platform/windows/windows_security_monitor.cc",
            "platform/macos/macos_security_monitor.mm",
            "platform/linux/linux_security_monitor.cc"
          ],
          "purpose": "Native security monitoring at browser process level"
        },
        {
          "path": "chrome/browser/blocked_video/",
          "files": [
            "blocked_video_capture_service.h",
            "blocked_video_capture_service.cc",
            "video_stream_manager.h",
            "video_stream_manager.cc"
          ],
          "purpose": "Webcam capture and streaming"
        },
        {
          "path": "chrome/browser/blocked_telemetry/",
          "files": [
            "blocked_telemetry_service.h",
            "blocked_telemetry_service.cc",
            "system_metrics_collector.h",
            "system_metrics_collector.cc"
          ],
          "purpose": "System telemetry collection"
        },
        {
          "path": "chrome/browser/blocked_ipc/",
          "files": [
            "blocked_backend_connector.h",
            "blocked_backend_connector.cc",
            "websocket_client.h",
            "websocket_client.cc"
          ],
          "purpose": "WebSocket connection to Blockd backend"
        },
        {
          "path": "content/renderer/blocked_eye_tracking/",
          "files": [
            "eye_tracking_worker.h",
            "eye_tracking_worker.cc",
            "mediapipe_integration.h",
            "mediapipe_integration.cc"
          ],
          "purpose": "Eye tracking in renderer process"
        }
      ],

      "core_modifications": [
        {
          "file": "chrome/browser/ui/browser.cc",
          "function": "Browser::AddTab()",
          "modification": "Block new tab creation during active session",
          "code_snippet": "if (BlockedSessionManager::IsSessionActive()) { return nullptr; }"
        },
        {
          "file": "chrome/browser/ui/exclusive_access/fullscreen_controller.cc",
          "function": "FullscreenController::ExitFullscreen()",
          "modification": "Prevent fullscreen exit during session",
          "code_snippet": "if (BlockedSessionManager::IsSessionActive() && !BlockedSessionManager::CanExitFullscreen()) { return false; }"
        },
        {
          "file": "content/browser/renderer_host/render_widget_host_impl.cc",
          "function": "RenderWidgetHostImpl::ForwardKeyboardEvent()",
          "modification": "Filter keyboard shortcuts (Ctrl+T, Ctrl+N, etc.)",
          "code_snippet": "if (BlockedSessionManager::ShouldBlockKeyboardEvent(event)) { return; }"
        },
        {
          "file": "content/public/browser/browser_context.h",
          "class": "BrowserContext",
          "modification": "Add BlockedSessionManager member",
          "code_snippet": "class BlockedSessionManager* blocked_session_manager_;"
        },
        {
          "file": "content/common/user_agent.cc",
          "function": "GetUserAgent()",
          "modification": "Custom user agent string",
          "code_snippet": "return \"Mozilla/5.0 ... BlockedBrowser/1.0 Chrome/142.0.0.0\";"
        }
      ]
    },

    "build_configuration": {
      "gn_args": {
        "is_component_build": false,
        "is_official_build": true,
        "is_debug": false,
        "blocked_enable_security_monitoring": true,
        "blocked_enable_eye_tracking": true,
        "blocked_enable_telemetry": true,
        "blocked_backend_url": "\"wss://api.blockd.com\"",
        "symbol_level": 1,
        "enable_nacl": false,
        "proprietary_codecs": true,
        "ffmpeg_branding": "\"Chrome\""
      },
      "build_command": "gn gen out/Blocked --args='...' && ninja -C out/Blocked chrome"
    },

    "ipc_protocol": {
      "transport": "WebSocket (wss://)",
      "serialization": "Protocol Buffers",
      "messages": [
        {
          "name": "SessionValidate",
          "direction": "Browser → Backend",
          "fields": ["session_token", "browser_version", "platform"]
        },
        {
          "name": "SessionStart",
          "direction": "Backend → Browser",
          "fields": ["session_id", "settings"]
        },
        {
          "name": "SecurityEvent",
          "direction": "Browser → Backend",
          "fields": ["event_type", "severity", "timestamp", "metadata"]
        },
        {
          "name": "GazeData",
          "direction": "Browser → Backend",
          "fields": ["session_id", "gaze_x", "gaze_y", "timestamp"]
        }
      ],
      "proto_file": "chrome/browser/blocked_ipc/blocked_protocol.proto"
    },

    "auto_update": {
      "windows": {
        "framework": "Omaha",
        "update_url": "https://update.blockd.com/service/update2",
        "check_interval": "24 hours"
      },
      "macos": {
        "framework": "Sparkle",
        "appcast_url": "https://update.blockd.com/macos/appcast.xml"
      },
      "linux": {
        "framework": "AppImage update mechanism",
        "check_url": "https://update.blockd.com/linux/latest"
      }
    },

    "packaging": {
      "windows": {
        "installer": "NSIS",
        "code_signing": "DigiCert or Sectigo certificate",
        "output": "BlockedBrowser_Setup_v1.0.0.exe"
      },
      "macos": {
        "package": ".dmg with .app bundle",
        "code_signing": "Apple Developer ID",
        "notarization": "Required for macOS 10.15+",
        "output": "BlockedBrowser-v1.0.0.dmg"
      },
      "linux": {
        "formats": ["AppImage", "DEB", "RPM"],
        "output": ["BlockedBrowser-v1.0.0.AppImage", "blockd-browser_1.0.0_amd64.deb"]
      }
    }
  },

  "agent_17": {
    "name": "Chromium Security Module Spec Developer",

    "windows_implementation": {
      "language": "C++ with Win32 API and WMI",
      "headers": ["windows.h", "wmi.h", "tlhelp32.h", "psapi.h"],

      "features": [
        {
          "name": "Process Enumeration",
          "apis": ["CreateToolhelp32Snapshot", "Process32First", "Process32Next"],
          "detection_targets": [
            "ChatGPT.exe",
            "claude.exe",
            "obs64.exe",
            "obs32.exe",
            "Camtasia.exe",
            "Bandicam.exe",
            "TeamViewer.exe"
          ],
          "code_snippet": "HANDLE snapshot = CreateToolhelp32Snapshot(TH32CS_SNAPPROCESS, 0);"
        },
        {
          "name": "Window Monitoring",
          "apis": ["EnumWindows", "GetWindowText", "GetForegroundWindow", "DwmGetWindowAttribute"],
          "purpose": "Detect focus changes to other applications",
          "events": ["window_focus_changed", "window_minimized", "window_hidden"]
        },
        {
          "name": "Screen Recording Detection",
          "apis": ["DwmGetWindowAttribute with DWMWA_CLOAKED"],
          "detection": "Identify hidden windows capturing screen (OBS, etc.)",
          "severity": "high"
        },
        {
          "name": "Virtual Machine Detection",
          "methods": [
            "CPUID instruction (check for hypervisor bit)",
            "Registry keys (HKLM\\\\HARDWARE\\\\DEVICEMAP\\\\Scsi\\\\Scsi Port 0\\\\Scsi Bus 0\\\\Target Id 0\\\\Logical Unit Id 0 - Identifier contains VBOX/VMWARE)",
            "SMBIOS manufacturer string",
            "Timing discrepancies"
          ],
          "vm_types": ["VMware", "VirtualBox", "Hyper-V", "Parallels"]
        },
        {
          "name": "Keyboard Hook Detection",
          "apis": ["GetKeyboardState", "GetAsyncKeyState"],
          "purpose": "Detect keyboard logging software"
        },
        {
          "name": "Clipboard Monitoring",
          "apis": ["AddClipboardFormatListener", "GetClipboardData"],
          "events": ["clipboard_copy", "clipboard_paste"]
        }
      ],

      "event_reporting": {
        "frequency": "Every 5 seconds (process check), Real-time (focus changes)",
        "format": "Protocol Buffer message to backend",
        "severity_mapping": {
          "vm_detected": "critical",
          "screen_recording": "high",
          "focus_changed": "medium",
          "clipboard_activity": "low"
        }
      }
    },

    "macos_implementation": {
      "language": "Objective-C++ (.mm files)",
      "frameworks": ["Cocoa", "IOKit", "Security"],

      "features": [
        {
          "name": "Process Enumeration",
          "apis": ["NSRunningApplication", "sysctl with KERN_PROC_ALL"],
          "detection_targets": [
            "ChatGPT",
            "Claude",
            "Screen Recording.app",
            "QuickTime Player (with screen recording)",
            "OBS",
            "TeamViewer"
          ]
        },
        {
          "name": "Screen Recording Detection",
          "method": "Check CGWindowListCopyWindowInfo for kCGWindowListOptionOnScreenOnly",
          "indicators": "Look for windows with layer < 0 (screen recording overlays)"
        },
        {
          "name": "VM Detection",
          "methods": [
            "ioreg -l | grep -e Manufacturer (VMware, VirtualBox, Parallels)",
            "sysctl hw.model (check for VM identifiers)",
            "IOPlatformExpertDevice property checks"
          ]
        },
        {
          "name": "Window Focus Monitoring",
          "apis": ["NSWorkspace.shared.frontmostApplication", "NSWorkspaceDidActivateApplicationNotification"],
          "events": "Application switch detection"
        },
        {
          "name": "Accessibility Permissions",
          "requirement": "Request AXIsProcessTrusted() for full monitoring",
          "fallback": "Limited monitoring without accessibility"
        }
      ]
    },

    "linux_implementation": {
      "language": "C++ with X11/Wayland APIs",
      "libraries": ["X11", "proc filesystem", "dbus"],

      "features": [
        {
          "name": "Process Enumeration",
          "method": "Read /proc/[pid]/cmdline and /proc/[pid]/comm",
          "detection_targets": ["chatgpt", "claude", "obs", "simplescreenrecorder", "kazam", "teamviewer"]
        },
        {
          "name": "Window Manager Integration",
          "x11_apis": ["XGetInputFocus", "XGetWindowProperty"],
          "wayland_note": "Limited access due to security model, may require compositor cooperation"
        },
        {
          "name": "VM Detection",
          "methods": [
            "Check /sys/class/dmi/id/ files (product_name, sys_vendor)",
            "lscpu output parsing",
            "Check for /dev/vbox* devices"
          ]
        },
        {
          "name": "Screen Recording Detection",
          "challenges": "No universal API, check for known recording processes",
          "heuristics": "Monitor CPU/GPU usage patterns"
        }
      ]
    },

    "cross_platform_architecture": {
      "interface": "chrome/browser/blocked_security/blocked_security_interface.h",
      "platform_implementations": [
        "blocked_security_windows.cc",
        "blocked_security_mac.mm",
        "blocked_security_linux.cc"
      ],
      "common_code": "blocked_security_service.cc (delegates to platform impl)"
    }
  },

  "agent_18": {
    "name": "Chromium Eye Tracking & Video Spec Developer",

    "eye_tracking_renderer_integration": {
      "location": "content/renderer/blocked_eye_tracking/",
      "architecture": "Runs in renderer process, sends data to browser process via Mojo IPC",

      "mediapipe_integration": {
        "library": "MediaPipe FaceMesh WASM",
        "loading": "Load mediapipe_face_mesh.wasm from resources",
        "initialization": "Initialize in renderer process on session start",
        "processing": "Process webcam frames at 30 FPS"
      },

      "gaze_calculation": {
        "input": "468-point facial landmarks from MediaPipe",
        "output": "2D screen coordinates (gaze_x, gaze_y)",
        "algorithm": "Custom gaze estimation (as specified in Agent 10)",
        "filtering": "Kalman filter for smoothing",
        "latency_target": "< 50ms per frame"
      },

      "mojo_ipc": {
        "interface_file": "chrome/browser/blocked/public/mojom/eye_tracking.mojom",
        "messages": [
          {
            "name": "OnGazeUpdate",
            "direction": "Renderer → Browser",
            "fields": ["gaze_x: float", "gaze_y: float", "confidence: float", "timestamp: uint64"]
          },
          {
            "name": "StartEyeTracking",
            "direction": "Browser → Renderer",
            "fields": ["session_id: string"]
          },
          {
            "name": "StopEyeTracking",
            "direction": "Browser → Renderer",
            "fields": []
          }
        ]
      },

      "webcam_access": {
        "permission": "Automatically granted for Blocked sessions (bypass normal permission model)",
        "api": "Use existing getUserMedia infrastructure",
        "stream_handling": "Capture video stream in renderer, process frames locally"
      }
    },

    "video_capture_integration": {
      "location": "chrome/browser/blocked_video/",
      "capture_source": "Webcam via MediaStreamAPI",
      "encoding": "Send raw frames or H.264 encoded stream to backend",
      "transport": "WebSocket binary frames or WebRTC data channel",

      "recording_pipeline": [
        "1. Capture webcam stream in renderer",
        "2. Send frames to browser process",
        "3. Browser process forwards to backend via WebSocket",
        "4. Backend (Agent 12) records with FFmpeg"
      ]
    },

    "fullscreen_enforcement": {
      "modification": "chrome/browser/ui/exclusive_access/fullscreen_controller.cc",
      "behavior": [
        "Enter fullscreen on session start",
        "Disable F11 key (fullscreen toggle)",
        "Disable Escape key (fullscreen exit)",
        "Prevent programmatic fullscreen exit",
        "Allow exit only when session ends via backend command"
      ],
      "bypass_prevention": "Block alt+tab, Windows key, task manager shortcut during session"
    },

    "ui_overlay": {
      "location": "chrome/browser/resources/blocked/",
      "technology": "Web Components (HTML/CSS/JS)",
      "elements": [
        "Session status indicator (top bar)",
        "Recording indicator (red dot)",
        "Connection status (WebSocket)",
        "Timer (session duration)",
        "Exit button (disabled during active session)"
      ],
      "injection": "Injected into all pages during active session via content scripts"
    },

    "session_lockdown": {
      "features": [
        "Block new tab creation (Browser::AddTab returns null)",
        "Block new window creation (Browser::Create returns null)",
        "Block navigation to non-interview URLs",
        "Block downloads",
        "Block file uploads (except answer submissions)",
        "Block DevTools (F12)",
        "Block extensions during session"
      ],
      "release": "All restrictions lifted when session ends"
    }
  },

  "build_and_distribution_workflow": {
    "step_1_checkout": "fetch --nohooks chromium && gclient sync",
    "step_2_apply_patches": "Apply Blocked modifications as patches or direct code changes",
    "step_3_build": "gn gen out/Blocked && ninja -C out/Blocked chrome",
    "step_4_package": "Create installers for each platform",
    "step_5_sign": "Code sign with platform-specific certificates",
    "step_6_distribute": "Upload to update servers and download page",
    "step_7_test": "Automated testing on Windows/macOS/Linux VMs"
  },

  "testing_requirements": {
    "unit_tests": [
      "Security monitoring platform detection",
      "Process enumeration accuracy",
      "Gaze calculation accuracy",
      "Mojo IPC message passing"
    ],
    "integration_tests": [
      "Full session lifecycle (start to end)",
      "Fullscreen enforcement",
