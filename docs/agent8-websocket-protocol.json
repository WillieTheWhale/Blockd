      "poor": "> 300ms latency"
    },
    "monitoring": {
      "track_latency": "Calculate from ping timestamp and pong response",
      "track_missed_pongs": "Increment if no pong within timeout",
      "auto_disconnect": "Disconnect after 3 consecutive missed pongs",
      "statistics": "Average, min, max latency across all connections"
    }
  },

  "gaze_streaming": {
    "source": "Interviewee browser client (30 Hz)",
    "throttling": "Server throttles to 10 Hz for broadcast",
    "authorization": "Only interviewees can stream gaze data",
