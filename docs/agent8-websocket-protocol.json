      },
      {
        "attempt": 10,
        "delay": "30000ms ±6000ms (capped)",
        "cumulative_time": "~151s"
      }
    ],
    "on_max_attempts": "Client should notify user and offer manual reconnect"
  },

  "rate_limiting": {
    "configuration": {
      "max_events_per_minute": 1000,
      "check_interval": "1000ms (1 second)",
      "violation_threshold": 5
    },
    "enforcement": {
      "per_socket": "Each socket has independent rate limit",
      "sliding_window": "Rate calculated over sliding time window",
      "on_exceed": "Emit error event to client, block event processing",
      "on_violations": "Disconnect socket after 5 violations"
    },
    "good_behavior_recovery": {
      "condition": "Event rate drops below 50% of limit",
      "action": "Decrement violation counter"
    },
    "exemptions": [
      "ping/pong events (heartbeat)",
      "connect/disconnect events"
    ]
  },

  "heartbeat_monitoring": {
    "ping_interval": "25000ms (25 seconds)",
    "ping_timeout": "20000ms (20 seconds)",
    "missed_pongs_threshold": 3,
    "latency_warning_threshold": "500ms",
    "connection_quality": {
