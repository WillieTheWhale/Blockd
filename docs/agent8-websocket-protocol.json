        "status": 401,
        "cause": "Missing or invalid JWT token",
        "action": "Reject connection"
      },
      "AUTHORIZATION_ERROR": {
        "status": 403,
        "cause": "Insufficient permissions for action",
        "action": "Emit error event, ignore request"
      },
