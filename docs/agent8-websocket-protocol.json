  },

  "deployment_configuration": {
    "environment_variables": [
      "NODE_ENV (development|production)",
      "PORT (default: 3003)",
      "HOST (default: 0.0.0.0)",
      "ALLOWED_ORIGINS (comma-separated)",
      "CORS_CREDENTIALS (default: true)",
      "TRANSPORTS (default: websocket,polling)",
      "PING_INTERVAL (default: 25000)",
      "PING_TIMEOUT (default: 20000)",
      "MAX_HTTP_BUFFER_SIZE (default: 1000000)",
      "REDIS_HOST (required)",
      "REDIS_PORT (default: 6379)",
      "REDIS_PASSWORD (optional)",
      "REDIS_DB (default: 0)",
      "REDIS_KEY_PREFIX (default: blockd:ws)",
      "JWT_PUBLIC_KEY_PATH (required)",
      "JWT_ALGORITHM (default: RS256)",
      "JWT_ISSUER (default: blockd-auth)",
      "JWT_AUDIENCE (default: blockd-api)",
      "RATE_LIMIT_MAX_EVENTS (default: 1000)",
      "RATE_LIMIT_CHECK_INTERVAL (default: 1000)",
      "MESSAGE_BUFFER_MAX_SIZE (default: 100)",
      "MESSAGE_BUFFER_MAX_AGE_MS (default: 300000)",
      "RECONNECT_MAX_ATTEMPTS (default: 10)",
      "RECONNECT_INITIAL_DELAY (default: 1000)",
      "RECONNECT_MAX_DELAY (default: 30000)",
      "GAZE_THROTTLE_HZ (default: 10)",
      "LOG_LEVEL (default: info in production, debug in development)",
      "LOG_FORMAT (default: json in production, pretty in development)"
    ],
    "health_check": {
      "endpoint": "GET /health",
      "response": {
        "status": "ok",
        "service": "websocket-service",
        "timestamp": "ISO 8601"
      }
    },
    "graceful_shutdown": {
      "signals": ["SIGTERM", "SIGINT"],
      "steps": [
        "Stop accepting new connections",
        "Disconnect all connected sockets gracefully",
        "Close Socket.io server",
        "Disconnect Redis adapter",
        "Exit process"
      ],
      "timeout": "30 seconds maximum"
    }
  },

  "monitoring_and_observability": {
    "metrics_to_track": [
      "total_connections",
      "connections_by_role",
      "total_rooms",
      "rooms_by_type",
