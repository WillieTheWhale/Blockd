// Mojo interface for Blocked session management.

module blocked.mojom;

import "content/public/common/blocked_mojom/audio_capture.mojom";
import "content/public/common/blocked_mojom/eye_tracking.mojom";
import "content/public/common/blocked_mojom/video_capture.mojom";

// Session state.
enum SessionState {
  IDLE,
  INITIALIZING,
  CALIBRATING,
  ACTIVE,
  PAUSED,
  ENDED,
  ERROR,
};

// Browser-side interface (implemented in browser process).
// Main interface for session coordination.
interface BlockedSessionHost {
  // Renderer reports ready for session.
  OnRendererReady();

  // Renderer sends session event.
  OnSessionEvent(string event_type, string data);

  // Get current session state.
  GetSessionState() => (SessionState state);

  // Bind eye tracking interface.
  BindEyeTracking(pending_receiver<EyeTrackingHost> eye_tracking_host,
                  pending_remote<EyeTrackingClient> eye_tracking_client);

  // Bind video capture interface.
  BindVideoCapture(pending_receiver<VideoCaptureHost> video_capture_host,
                   pending_remote<VideoCaptureClient> video_capture_client);

  // Bind audio capture interface.
  BindAudioCapture(pending_receiver<AudioCaptureHost> audio_capture_host,
                   pending_remote<AudioCaptureClient> audio_capture_client);
};

// Renderer-side interface (implemented in renderer process).
interface BlockedSessionClient {
  // Browser notifies session state change.
  OnSessionStateChanged(SessionState new_state);

  // Browser sends session configuration.
  OnSessionConfig(SessionConfig config);

  // Browser requests to end session.
  EndSession();
};

// Session configuration.
struct SessionConfig {
  string session_id;
  string session_token;
  bool enable_eye_tracking;
  bool enable_video_capture;
  bool enable_audio_capture;
  bool enable_security_monitoring;
  CalibrationSettings calibration_settings;
  VideoCaptureSettings video_settings;
  AudioCaptureSettings audio_settings;
};
