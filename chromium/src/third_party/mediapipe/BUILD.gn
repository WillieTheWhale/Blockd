# MediaPipe FaceMesh integration for Blocked eye tracking.
#
# This provides a wrapper around MediaPipe for face landmark detection
# used by the eye tracking system. The actual MediaPipe library integration
# uses TensorFlow Lite for inference with pre-trained models.
#
# Models are downloaded from Google's MediaPipe model repository and included
# in the build output. See models/README.md for model information.

import("//build/config/features.gni")

config("mediapipe_config") {
  include_dirs = [ "." ]

  defines = [
    "MEDIAPIPE_DISABLE_GPU=1",  # Use CPU-only for renderer process
    "BLOCKED_MEDIAPIPE_WRAPPER",
  ]
}

# Blocked-specific MediaPipe wrapper
# This is a self-contained implementation that can work in stub mode
# or with full MediaPipe when available.
static_library("blocked_mediapipe") {
  sources = [
    "blocked_facemesh_wrapper.cc",
    "blocked_facemesh_wrapper.h",
  ]

  public_configs = [ ":mediapipe_config" ]

  deps = [
    "//base",
  ]

  # When full MediaPipe is available, add TFLite dependency
  # deps += [ "//third_party/tflite:tflite" ]
}

# Model files directory - these would be downloaded by the build system
# For now, create placeholder structure
group("mediapipe_models") {
  # In production build, this would copy model files:
  # - face_landmarker.task (18MB combined model)
  # - Alternative: separate .tflite files
  #   - face_detection_short_range.tflite
  #   - face_landmark.tflite
  #   - iris_landmark.tflite
  #
  # Models are expected at:
  #   $root_out_dir/resources/mediapipe/
}

# Unit tests - stub for now
source_set("blocked_mediapipe_unittests") {
  testonly = true

  sources = [
    "blocked_facemesh_wrapper_unittest.cc",
  ]

  deps = [
    ":blocked_mediapipe",
    "//base",
    "//base/test:test_support",
    "//testing/gtest",
  ]
}
