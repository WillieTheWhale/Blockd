import("//build/config/features.gni")

# Security monitoring module
source_set("security_monitoring") {
  sources = [
    "blocked_security_service.cc",
    "blocked_security_service.h",
  ]

  deps = [
    "//base",
    "//components/keyed_service/core",
    "//content/public/browser",
  ]

  if (is_win) {
    sources += [
      "platform/windows/windows_security_monitor.cc",
      "platform/windows/windows_security_monitor.h",
    ]

    libs = [
      "dwmapi.lib",
      "psapi.lib",
      "wintrust.lib",
    ]
  }

  if (is_mac) {
    sources += [
      "platform/macos/macos_security_monitor.h",
      "platform/macos/macos_security_monitor.mm",
    ]

    frameworks = [
      "AppKit.framework",
      "Cocoa.framework",
      "IOKit.framework",
      "Security.framework",
    ]
  }

  if (is_linux) {
    sources += [
      "platform/linux/linux_platform_detector.cc",
      "platform/linux/linux_platform_detector.h",
      "platform/linux/linux_security_monitor.cc",
      "platform/linux/linux_security_monitor.h",
      "platform/linux/wayland_clipboard_monitor.cc",
      "platform/linux/wayland_clipboard_monitor.h",
      "platform/linux/x11_clipboard_monitor.cc",
      "platform/linux/x11_clipboard_monitor.h",
    ]

    deps += [
      "//dbus",
      "//ui/gfx/x",
    ]

    # X11 libraries for window title detection and clipboard monitoring
    libs = [
      "X11",
      "Xfixes",
    ]
  }

  configs += [ "//chrome/browser/blocked:blocked_config" ]
}

# Unit tests
source_set("security_monitoring_unittests") {
  testonly = true

  sources = [
    "blocked_security_service_unittest.cc",
  ]

  deps = [
    ":security_monitoring",
    "//base/test:test_support",
    "//testing/gtest",
  ]
}
