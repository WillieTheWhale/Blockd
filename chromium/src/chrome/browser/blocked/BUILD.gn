# Build file for Blocked browser modules

import("//build/config/features.gni")
import("//chrome/browser/blocked/blocked_features.gni")

# Main Blocked browser modules aggregation
group("blocked_browser_modules") {
  deps = [
    "//chrome/browser/blocked/blocked_audio:blocked_audio",
    "//chrome/browser/blocked/blocked_ipc:ipc",
    "//chrome/browser/blocked/blocked_security:security_monitoring",
    "//chrome/browser/blocked/blocked_session_detection:session_detection",
    "//chrome/browser/blocked/blocked_startup:blocked_startup",
    "//chrome/browser/blocked/blocked_telemetry:telemetry",
    "//chrome/browser/blocked/blocked_video:video_capture",
    "//chrome/browser/ui/webui/blocked_home:blocked_home",
  ]
}

# Configuration for Blocked-specific flags
config("blocked_config") {
  defines = [
    "BLOCKED_BROWSER",
  ]

  if (blocked_enable_security_monitoring) {
    defines += [ "BLOCKED_ENABLE_SECURITY_MONITORING" ]
  }

  if (blocked_enable_eye_tracking) {
    defines += [ "BLOCKED_ENABLE_EYE_TRACKING" ]
  }

  if (blocked_enable_telemetry) {
    defines += [ "BLOCKED_ENABLE_TELEMETRY" ]
  }

  if (blocked_backend_url != "") {
    defines += [ "BLOCKED_BACKEND_URL=\"${blocked_backend_url}\"" ]
  }
}
