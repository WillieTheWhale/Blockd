# Feature flags for the Blocked browser components

declare_args() {
  # Enable security monitoring (process detection, VM detection, etc.)
  blocked_enable_security_monitoring = true

  # Enable eye tracking via MediaPipe FaceMesh
  blocked_enable_eye_tracking = true

  # Enable telemetry collection
  blocked_enable_telemetry = true

  # Enable video capture for session recording
  blocked_enable_video_capture = true

  # Backend WebSocket URL for session communication
  blocked_backend_url = "wss://api.blockd.com"
}
