import("//third_party/protobuf/proto_library.gni")

proto_library("blocked_protocol_proto") {
  sources = [ "blocked_protocol.proto" ]

  extra_configs = [ "//build/config/compiler:wexit_time_destructors" ]
}

# Backend connector for WebSocket communication (no circular deps).
source_set("blocked_ipc") {
  sources = [
    "blocked_backend_connector.cc",
    "blocked_backend_connector.h",
  ]

  deps = [
    ":blocked_protocol_proto",
    "//base",
    "//components/keyed_service/core",
    "//mojo/public/cpp/bindings",
    "//mojo/public/cpp/system",
    "//net",
    "//services/network/public/cpp",
    "//services/network/public/mojom",
    "//url",
  ]

  configs += [ "//chrome/browser/blocked:blocked_config" ]
}

# Session host implementation (depends on video_capture).
source_set("session_host") {
  sources = [
    "blocked_session_host_impl.cc",
    "blocked_session_host_impl.h",
  ]

  deps = [
    ":blocked_ipc",
    "//base",
    "//chrome/browser/blocked/blocked_video:video_capture",
    "//components/keyed_service/core",
    "//content/public/common/blocked_mojom",
    "//mojo/public/cpp/bindings",
  ]

  configs += [ "//chrome/browser/blocked:blocked_config" ]
}

# Combined target for convenience (legacy alias).
group("ipc") {
  public_deps = [
    ":blocked_ipc",
    ":session_host",
  ]
}
