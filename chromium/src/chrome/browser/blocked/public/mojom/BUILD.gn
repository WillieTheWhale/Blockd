# Re-export the Blocked mojom interfaces from content/public/common.
# This allows browser-side code to use the same interfaces as renderer-side.

group("mojom") {
  public_deps = [
    "//content/public/common/blocked_mojom",
  ]
}

# Shared types from content/public/common.
group("blocked_mojom_traits") {
  public_deps = [
    "//content/public/common/blocked_mojom:blocked_mojom_traits",
  ]
}
