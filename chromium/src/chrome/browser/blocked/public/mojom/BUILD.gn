# Mojo interfaces for Blocked browser-renderer IPC.

import("//mojo/public/tools/bindings/mojom.gni")

mojom("mojom") {
  sources = [
    "eye_tracking.mojom",
    "session.mojom",
    "video_capture.mojom",
  ]

  public_deps = [
    "//mojo/public/mojom/base",
  ]

  # Generate C++ bindings.
  cpp_typemaps = [
    {
      types = [
        {
          mojom = "blocked.mojom.GazeData"
          cpp = "::blocked::GazeData"
        },
      ]
    },
  ]

  # Generate JavaScript bindings for web API.
  webui_module_path = "chrome/browser/blocked/public/mojom"
}

# Shared types and constants.
source_set("blocked_mojom_traits") {
  sources = [
    "blocked_mojom_traits.cc",
    "blocked_mojom_traits.h",
  ]

  deps = [
    ":mojom",
    "//base",
    "//mojo/public/cpp/bindings",
  ]
}
