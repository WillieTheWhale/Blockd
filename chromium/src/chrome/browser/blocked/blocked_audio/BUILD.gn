# Audio capture service for Blocked browser process.

import("//build/config/features.gni")

source_set("blocked_audio") {
  sources = [
    "blocked_audio_capture_service.cc",
    "blocked_audio_capture_service.h",
  ]

  deps = [
    "//base",
    "//chrome/browser/blocked/blocked_ipc:ipc",
    "//components/keyed_service/core",
    "//content/public/common/blocked_mojom",
    "//mojo/public/cpp/bindings",
  ]

  # Allow access from blocked browser modules.
  visibility = [
    ":*",
    "//chrome/browser/blocked:*",
  ]
}
