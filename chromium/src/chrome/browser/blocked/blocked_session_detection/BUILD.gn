# Session detection module for Blocked browser.
# Detects navigation to interview platforms and manages session lifecycle.

import("//build/config/features.gni")

source_set("session_detection") {
  sources = [
    "session_detector.cc",
    "session_detector.h",
    "url_pattern_matcher.cc",
    "url_pattern_matcher.h",
  ]

  deps = [
    "//base",
    "//content/public/browser",
    "//url",
  ]

  # Allow access from blocked browser modules.
  visibility = [
    ":*",
    "//chrome/browser/blocked:*",
  ]
}

# Unit tests
source_set("session_detection_unittests") {
  testonly = true

  sources = [
    "url_pattern_matcher_unittest.cc",
  ]

  deps = [
    ":session_detection",
    "//base",
    "//base/test:test_support",
    "//testing/gtest",
    "//url",
  ]
}
