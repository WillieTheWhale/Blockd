import("//build/config/features.gni")

source_set("telemetry") {
  sources = [
    "blocked_telemetry_service.h",
  ]

  # Use .cc on non-macOS, .mm on macOS (due to Objective-C usage)
  if (is_mac) {
    sources += [ "blocked_telemetry_service.mm" ]
  } else {
    sources += [ "blocked_telemetry_service.cc" ]
  }

  deps = [
    "//base",
    "//components/keyed_service/core",
    "//ui/gfx",
  ]

  if (is_mac) {
    frameworks = [
      "Cocoa.framework",
      "Foundation.framework",
    ]
  }

  configs += [ "//chrome/browser/blocked:blocked_config" ]
}
