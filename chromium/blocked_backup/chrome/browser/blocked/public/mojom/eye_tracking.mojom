// Mojo interface for eye tracking communication between renderer and browser.

module blocked.mojom;

import "mojo/public/mojom/base/time.mojom";

// Gaze data point from renderer to browser.
struct GazeData {
  float x;  // Normalized screen coordinate 0-1 (left to right)
  float y;  // Normalized screen coordinate 0-1 (top to bottom)
  float confidence;  // Quality metric 0-1
  bool is_off_screen;
  string off_screen_direction;  // "left", "right", "up", "down", "unknown"
  mojo_base.mojom.TimeTicks timestamp;
};

// Calibration point for 9-point calibration.
struct CalibrationPoint {
  float screen_x;
  float screen_y;
  array<GazeData> samples;  // Collected gaze samples at this point
};

// Browser-side interface (implemented in browser process).
// Receives eye tracking data from renderer.
interface EyeTrackingHost {
  // Renderer sends gaze update to browser.
  OnGazeUpdate(GazeData gaze);

  // Renderer sends batch of gaze updates (more efficient).
  OnGazeBatch(array<GazeData> gazes);

  // Renderer reports calibration complete.
  OnCalibrationComplete(array<CalibrationPoint> calibration_data);

  // Renderer reports eye tracking error.
  OnEyeTrackingError(string error_message);
};

// Renderer-side interface (implemented in renderer process).
// Receives commands from browser.
interface EyeTrackingClient {
  // Browser requests to start eye tracking.
  StartEyeTracking(string session_id);

  // Browser requests to stop eye tracking.
  StopEyeTracking();

  // Browser requests to start calibration.
  StartCalibration();

  // Browser provides calibration settings.
  SetCalibrationSettings(CalibrationSettings settings);
};

// Calibration settings.
struct CalibrationSettings {
  int32 num_points;  // 9 for 3x3 grid
  int32 duration_per_point_ms;  // Default 2000ms
  int32 samples_per_point;  // Default 60
};
