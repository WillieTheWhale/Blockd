// Mojo interface for video capture communication between renderer and browser.

module blocked.mojom;

import "mojo/public/mojom/base/time.mojom";
import "mojo/public/mojom/base/big_buffer.mojom";

// Video frame format.
enum VideoFormat {
  I420,  // YUV 4:2:0 planar
  NV12,  // YUV 4:2:0 semi-planar
  RGB24,  // RGB 8-8-8
  H264,  // H.264 encoded
};

// Video frame metadata.
struct VideoFrameMetadata {
  int32 width;
  int32 height;
  VideoFormat format;
  mojo_base.mojom.TimeTicks timestamp;
  int64 frame_number;
};

// Browser-side interface (implemented in browser process).
// Receives video frames from renderer.
interface VideoCaptureHost {
  // Renderer sends video frame to browser.
  OnVideoFrame(mojo_base.mojom.BigBuffer frame_data,
               VideoFrameMetadata metadata);

  // Renderer sends encoded video frame (H.264).
  OnEncodedFrame(mojo_base.mojom.BigBuffer encoded_data,
                 mojo_base.mojom.TimeTicks timestamp);

  // Renderer reports video capture started.
  OnCaptureStarted(VideoCaptureSettings settings);

  // Renderer reports video capture stopped.
  OnCaptureStopped();

  // Renderer reports capture error.
  OnCaptureError(string error_message);
};

// Renderer-side interface (implemented in renderer process).
// Receives commands from browser.
interface VideoCaptureClient {
  // Browser requests to start video capture.
  StartCapture(VideoCaptureSettings settings);

  // Browser requests to stop video capture.
  StopCapture();

  // Browser requests to change capture settings.
  UpdateSettings(VideoCaptureSettings settings);
};

// Video capture settings.
struct VideoCaptureSettings {
  int32 width;  // Default 640
  int32 height;  // Default 480
  int32 frame_rate;  // Default 30
  VideoFormat format;  // Default I420
  string device_id;  // Empty for default camera
  bool enable_encoding;  // Encode to H.264 in renderer
};
