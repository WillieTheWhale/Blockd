source_set("video_capture") {
  sources = [
    "blocked_video_capture_service.cc",
    "blocked_video_capture_service.h",
  ]

  deps = [
    "//base",
    "//components/keyed_service/core",
    "//media/capture",
  ]

  configs += [ "//chrome/browser/blocked:blocked_config" ]
}

# Media stream capture for webcam and meeting tab capture
source_set("media_stream_capture") {
  sources = [
    "media_stream_capture.cc",
    "media_stream_capture.h",
  ]

  deps = [
    "//base",
    "//content/public/browser",
  ]

  public_deps = [
    "//base",
  ]

  configs += [ "//chrome/browser/blocked:blocked_config" ]
}

# Combined blocked_video module
source_set("blocked_video") {
  public_deps = [
    ":media_stream_capture",
    ":video_capture",
  ]
}
