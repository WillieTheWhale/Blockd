# MediaPipe FaceMesh graph configuration for Blocked.
# Detects 468 facial landmarks including iris landmarks.

input_stream: "input_video"
output_stream: "multi_face_landmarks"
output_stream: "face_detection"

# Face detection (short range).
node {
  calculator: "FaceDetectionShortRangeCommon"
  input_stream: "IMAGE:input_video"
  output_stream: "DETECTIONS:face_detection"
}

# Face landmark detection (468 points).
node {
  calculator: "FaceLandmarkFrontCommon"
  input_stream: "IMAGE:input_video"
  input_stream: "ROI:face_detection"
  output_stream: "LANDMARKS:multi_face_landmarks"
}

# Iris landmark detection.
node {
  calculator: "IrisLandmarkLeftAndRightCommon"
  input_stream: "IMAGE:input_video"
  input_stream: "FACE_LANDMARKS:multi_face_landmarks"
  output_stream: "LEFT_EYE_IRIS_LANDMARKS:left_iris_landmarks"
  output_stream: "RIGHT_EYE_IRIS_LANDMARKS:right_iris_landmarks"
}

# Configuration options.
node_options: {
  [type.googleapis.com/mediapipe.FaceDetectionOptions] {
    min_detection_confidence: 0.5
  }
}

node_options: {
  [type.googleapis.com/mediapipe.FaceLandmarkOptions] {
    min_detection_confidence: 0.5
    min_tracking_confidence: 0.5
    refine_landmarks: true
  }
}
