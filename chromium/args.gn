# Blockd Browser - GN Build Arguments
# Production build configuration for Blockd Interview Browser

# ============================================
# Core Build Settings
# ============================================
is_component_build = false       # Monolithic build (all code in one binary)
is_official_build = true         # Enable release optimizations
is_debug = false                 # No debug assertions
symbol_level = 1                 # Minimal symbols for crash reporting

# ============================================
# Blockd Feature Flags
# ============================================
blockd_enable_security_monitoring = true
blockd_enable_eye_tracking = true
blockd_enable_telemetry = true
blockd_enable_video_capture = true
blockd_enable_media_streaming = true
blockd_enable_meeting_detection = true
blockd_backend_url = "wss://api.blockd.site"

# Default homepage - Blockd interviewee portal
# This is where interviewees land to select their meeting platform
blockd_default_homepage = "https://blockd.site/session"
blockd_startup_url = "https://blockd.site/session"

# Meeting platform detection patterns (comma-separated)
blockd_meeting_patterns = "meet.google.com,*.zoom.us,zoom.us,teams.microsoft.com,teams.live.com"

# ============================================
# Branding - BLOCKD CUSTOM BRANDING
# ============================================
# Use Chromium base (not Chrome branding)
is_chrome_branded = false

# Point to Blockd branding instead of default Chromium
# Note: Source directory uses "blocked" for backwards compatibility
branding_path_component = "blocked"
branding_path_product = "blocked"
branding_file_path = "//chrome/app/theme/blocked/BRANDING"

# Product name override (displays as "Blockd" to users)
chrome_product_short_name = "Blockd"
chrome_product_full_name = "Blockd"

# ============================================
# Compiler Optimization
# ============================================
use_thin_lto = true              # Link-time optimization
is_cfi = false                   # Control Flow Integrity (disabled for compatibility)
optimize_webui = true            # Optimize WebUI resources
enable_resource_allowlist_generation = false

# ============================================
# Codecs & Media
# ============================================
proprietary_codecs = true        # H.264, AAC support
ffmpeg_branding = "Chrome"       # Full codec support
enable_widevine = false          # No DRM needed
enable_hangout_services_extension = false

# ============================================
# Security & Sandboxing
# ============================================
is_asan = false                  # Address Sanitizer (disable for production)
is_msan = false                  # Memory Sanitizer (disable for production)
is_tsan = false                  # Thread Sanitizer (disable for production)
use_safe_libcxx = true           # Hardened libc++

# ============================================
# Platform Features
# ============================================
enable_nacl = false              # No Native Client support
enable_pdf = true                # PDF viewer support
enable_print_preview = true      # Print preview support
enable_extensions = true         # Chrome extensions (blocked during session)
enable_service_discovery = false # mDNS/DNS-SD (not needed)

# ============================================
# Network & Updates
# ============================================
enable_reporting = false         # No crash reporting to Google
google_api_key = ""              # No Google API key
google_default_client_id = ""
google_default_client_secret = ""

# ============================================
# Build Performance
# ============================================
use_jumbo_build = false          # Disable jumbo builds (better incremental builds)
enable_precompiled_headers = true
use_goma = false                 # Set to true if using distributed builds

# ============================================
# Toolchain
# ============================================
use_sysroot = true               # Use Chromium's sysroot (Linux)
use_custom_libcxx = true         # Use Chromium's libc++
clang_use_chrome_plugins = true  # Enable Chrome-specific compiler plugins

# ============================================
# Platform-Specific Settings
# ============================================
# Note: Platform conditionals are handled in BUILD.gn files.
# These are common settings that apply across platforms.

# Windows settings (applied when building on Windows)
win_console_app = false

# macOS settings (applied when building on macOS)
mac_deployment_target = "12.0"

# Linux settings (use bundled libraries for consistency)
use_system_freetype = false
use_system_harfbuzz = false
use_system_lcms2 = false
use_system_libdrm = false

# Use older SDK to avoid macOS 26.2 header redefinition bugs
mac_sdk_path = "/Library/Developer/CommandLineTools/SDKs/MacOSX15.5.sdk"

# Code signing configuration (set these for production builds):
# Windows: win_signing_cert_path, win_signing_cert_password
# macOS: mac_signing_identity, mac_signing_keychain

# ============================================
# Testing
# ============================================
# Note: These can be overridden for test builds
enable_js_type_check = false
enable_vr = false                # No VR support needed
enable_mdns = false              # No mDNS needed

# ============================================
# Custom Blocked Targets
# ============================================
# Defined in //chrome/browser/blocked/BUILD.gn
