 namespace content {

 namespace {
@@ -100,6 +104,15 @@ void ClipboardHostImpl::ReadText(ui::ClipboardBuffer buffer,
                                  ReadTextCallback callback) {
   DCHECK_CURRENTLY_ON(BrowserThread::UI);

+#ifdef BLOCKED_BROWSER
+  // Block reading from clipboard during active sessions.
+  if (blocked::BlockedBrowserController::Get() &&
