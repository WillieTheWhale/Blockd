From: Blockd Browser Team <dev@blockd.com>
Date: Fri, 10 Jan 2026 11:00:00 +0000
Subject: [PATCH 6/6] Block clipboard operations during interview sessions

Block copy, cut, paste, and select-all operations during active
Blocked interview sessions to prevent content exfiltration.

Changes:
- Block clipboard commands in RenderViewContextMenu
- Block clipboard access in ClipboardHost
- Block edit commands in RenderWidgetHostImpl
- Disable drag and drop during sessions

diff --git a/chrome/browser/renderer_context_menu/render_view_context_menu.cc b/chrome/browser/renderer_context_menu/render_view_context_menu.cc
index 2345678..clipboard1 100644
--- a/chrome/browser/renderer_context_menu/render_view_context_menu.cc
+++ b/chrome/browser/renderer_context_menu/render_view_context_menu.cc
@@ -450,6 +450,20 @@ bool RenderViewContextMenu::IsCommandIdEnabled(int command_id) const {
   switch (command_id) {
     case IDC_CONTENT_CONTEXT_CUT:
     case IDC_CONTENT_CONTEXT_COPY:
+    case IDC_CONTENT_CONTEXT_PASTE:
+    case IDC_CONTENT_CONTEXT_PASTE_AND_MATCH_STYLE:
+    case IDC_CONTENT_CONTEXT_SELECTALL:
+#ifdef BLOCKED_BROWSER
+      // Block clipboard commands during active sessions.
+      if (blocked::BlockedBrowserController::Get() &&
+          blocked::BlockedBrowserController::Get()->ShouldBlockClipboard()) {
+        return false;
+      }
+#endif
+      return IsClipboardCommandEnabled(command_id);
+
+    case IDC_CONTENT_CONTEXT_COPY_LINK_TO_CLIPBOARD:
+    case IDC_CONTENT_CONTEXT_COPY_IMAGE:
 #ifdef BLOCKED_BROWSER
       // Block clipboard commands during active sessions.
       if (blocked::BlockedBrowserController::Get() &&
@@ -457,8 +471,7 @@ bool RenderViewContextMenu::IsCommandIdEnabled(int command_id) const {
         return false;
       }
 #endif
-    case IDC_CONTENT_CONTEXT_PASTE:
-      return IsClipboardCommandEnabled(command_id);
+      return IsLinkOrImageCopyEnabled(command_id);

     default:
       return true;
@@ -500,6 +513,14 @@ void RenderViewContextMenu::ExecuteCommand(int command_id, int event_flags) {
   switch (command_id) {
     case IDC_CONTENT_CONTEXT_CUT:
     case IDC_CONTENT_CONTEXT_COPY:
+    case IDC_CONTENT_CONTEXT_PASTE:
+    case IDC_CONTENT_CONTEXT_PASTE_AND_MATCH_STYLE:
+    case IDC_CONTENT_CONTEXT_SELECTALL:
+    case IDC_CONTENT_CONTEXT_COPY_LINK_TO_CLIPBOARD:
+    case IDC_CONTENT_CONTEXT_COPY_IMAGE:
+#ifdef BLOCKED_BROWSER
+      // Commands already blocked by IsCommandIdEnabled, but double-check.
+      if (blocked::BlockedBrowserController::Get() &&
+          blocked::BlockedBrowserController::Get()->ShouldBlockClipboard()) {
+        LOG(WARNING) << "Blocked: Clipboard command blocked during session";
+        return;
+      }
+#endif
       ExecuteClipboardCommand(command_id);
       break;

diff --git a/content/browser/renderer_host/clipboard_host_impl.cc b/content/browser/renderer_host/clipboard_host_impl.cc
index 3456789..clipboard2 100644
