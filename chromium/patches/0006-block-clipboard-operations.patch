+
   std::u16string result;
   ui::Clipboard::GetForCurrentThread()->ReadText(
       buffer, /* data_dst= */ nullptr, &result);
@@ -120,6 +133,15 @@ void ClipboardHostImpl::ReadHtml(ui::ClipboardBuffer buffer,
                                  ReadHtmlCallback callback) {
   DCHECK_CURRENTLY_ON(BrowserThread::UI);

+#ifdef BLOCKED_BROWSER
+  // Block reading HTML from clipboard during active sessions.
+  if (blocked::BlockedBrowserController::Get() &&
+      blocked::BlockedBrowserController::Get()->ShouldBlockPaste()) {
+    std::move(callback).Run(std::u16string(), GURL(), 0, 0);
+    return;
+  }
+#endif
+
   std::u16string markup;
   GURL src_url;
   uint32_t fragment_start, fragment_end;
@@ -150,6 +172,15 @@ void ClipboardHostImpl::WriteText(const std::u16string& text) {
   DCHECK_CURRENTLY_ON(BrowserThread::UI);
   DCHECK(googlechrome_check_->HasPendingCopy());

+#ifdef BLOCKED_BROWSER
+  // Block writing to clipboard during active sessions.
+  if (blocked::BlockedBrowserController::Get() &&
+      blocked::BlockedBrowserController::Get()->ShouldBlockCopy()) {
+    LOG(WARNING) << "Blocked: WriteText to clipboard blocked during session";
+    return;
+  }
+#endif
+
   clipboard_writer_->WriteText(text);
 }

@@ -157,6 +188,15 @@ void ClipboardHostImpl::WriteHtml(const std::u16string& markup,
                                   const GURL& url) {
   DCHECK_CURRENTLY_ON(BrowserThread::UI);

+#ifdef BLOCKED_BROWSER
+  // Block writing HTML to clipboard during active sessions.
+  if (blocked::BlockedBrowserController::Get() &&
+      blocked::BlockedBrowserController::Get()->ShouldBlockCopy()) {
+    LOG(WARNING) << "Blocked: WriteHtml to clipboard blocked during session";
+    return;
+  }
+#endif
+
   clipboard_writer_->WriteHTML(markup, url.spec());
 }

@@ -180,6 +220,15 @@ void ClipboardHostImpl::ReadImage(ui::ClipboardBuffer buffer,
                                   ReadImageCallback callback) {
   DCHECK_CURRENTLY_ON(BrowserThread::UI);

+#ifdef BLOCKED_BROWSER
+  // Block reading images from clipboard during active sessions.
+  if (blocked::BlockedBrowserController::Get() &&
+      blocked::BlockedBrowserController::Get()->ShouldBlockPaste()) {
+    std::move(callback).Run(SkBitmap());
+    return;
+  }
+#endif
+
   SkBitmap result = ui::Clipboard::GetForCurrentThread()->ReadImage(
       buffer, /* data_dst= */ nullptr);
   std::move(callback).Run(std::move(result));
@@ -190,6 +239,15 @@ void ClipboardHostImpl::WriteImage(const SkBitmap& bitmap) {
   if (bitmap.empty())
     return;

+#ifdef BLOCKED_BROWSER
+  // Block writing images to clipboard during active sessions.
+  if (blocked::BlockedBrowserController::Get() &&
+      blocked::BlockedBrowserController::Get()->ShouldBlockCopy()) {
+    LOG(WARNING) << "Blocked: WriteImage to clipboard blocked during session";
+    return;
+  }
+#endif
+
   clipboard_writer_->WriteImage(bitmap);
 }

diff --git a/content/browser/renderer_host/render_widget_host_impl.cc b/content/browser/renderer_host/render_widget_host_impl.cc
index 4567890..clipboard3 100644
--- a/content/browser/renderer_host/render_widget_host_impl.cc
+++ b/content/browser/renderer_host/render_widget_host_impl.cc
@@ -100,6 +100,10 @@
 #include "ui/events/keycodes/keyboard_codes.h"
 #include "ui/gfx/geometry/size_conversions.h"

+#ifdef BLOCKED_BROWSER
+#include "chrome/browser/ui/blocked/blocked_browser_controller.h"
+#endif
+
 namespace content {

 namespace {
@@ -800,6 +804,22 @@ void RenderWidgetHostImpl::ExecuteEditCommand(
     const std::string& command,
     const std::optional<std::u16string>& value) {

+#ifdef BLOCKED_BROWSER
+  // Block edit commands during active sessions.
+  if (blocked::BlockedBrowserController::Get() &&
+      blocked::BlockedBrowserController::Get()->IsSessionActive()) {
+    // Block Copy, Cut, Paste, SelectAll commands.
+    if (command == "Copy" || command == "Cut" || command == "Paste" ||
+        command == "SelectAll" || command == "Delete" ||
+        command == "PasteAndMatchStyle") {
+      LOG(WARNING) << "Blocked: Edit command '" << command
+                   << "' blocked during session";
+      return;
+    }
+  }
+#endif
+
   GetWidgetInputHandler()->ExecuteEditCommand(command, value);
 }

