From: Blocked Browser Team <dev@blockd.com>
Date: Thu, 09 Jan 2026 10:00:00 +0000
Subject: [PATCH 4/4] Add Blocked WebUI registration and startup overrides

Register chrome://blocked-home WebUI and configure it as the
default startup page and new tab page.

Changes:
- Register BlockedHomeUIConfig in chrome_web_ui_configs.cc
- Override startup page to chrome://blocked-home
- Override new tab page to chrome://blocked-home
- Update BUILD.gn dependencies

diff --git a/chrome/browser/ui/webui/chrome_web_ui_configs.cc b/chrome/browser/ui/webui/chrome_web_ui_configs.cc
index 7890123..ghijklm 100644
--- a/chrome/browser/ui/webui/chrome_web_ui_configs.cc
+++ b/chrome/browser/ui/webui/chrome_web_ui_configs.cc
@@ -50,6 +50,10 @@
 #include "chrome/browser/ui/webui/version/version_ui.h"
 #include "content/public/browser/webui_config_map.h"

+#ifdef BLOCKED_BROWSER
+#include "chrome/browser/ui/webui/blocked_home/blocked_web_ui_configs.h"
+#endif
+
 namespace {

 void RegisterChromeWebUIConfigsImpl(content::WebUIConfigMap& map) {
@@ -100,6 +104,11 @@ void RegisterChromeWebUIConfigsImpl(content::WebUIConfigMap& map) {
   map.AddWebUIConfig(std::make_unique<VersionUIConfig>());
   map.AddWebUIConfig(std::make_unique<WelcomeUIConfig>());

+#ifdef BLOCKED_BROWSER
+  // Register Blocked WebUI configs
+  blocked::RegisterBlockedWebUIConfigs(map);
+#endif
+
   // Platform-specific WebUIs
 #if BUILDFLAG(IS_ANDROID)
   // Android-specific UIs
diff --git a/chrome/browser/ui/webui/BUILD.gn b/chrome/browser/ui/webui/BUILD.gn
index 8901234..hijklmn 100644
--- a/chrome/browser/ui/webui/BUILD.gn
+++ b/chrome/browser/ui/webui/BUILD.gn
@@ -100,6 +100,12 @@ static_library("webui") {
     "//ui/webui",
   ]

+  # Blocked browser WebUI modules
+  if (defined(blocked_browser) && blocked_browser) {
+    deps += [
+      "//chrome/browser/ui/webui/blocked_home:blocked_home",
+    ]
+  }
+
   if (is_android) {
     sources += android_sources
   }
