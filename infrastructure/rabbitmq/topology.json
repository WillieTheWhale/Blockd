{
  "rabbit_version": "4.0.0",
  "rabbitmq_version": "4.0.0",
  "users": [
    {
      "name": "blockd_user",
      "password_hash": "blockd_password_change_in_production",
      "hashing_algorithm": "rabbit_password_hashing_sha256",
      "tags": "administrator"
    }
  ],
  "vhosts": [
    {
      "name": "blockd"
    }
  ],
  "permissions": [
    {
      "user": "blockd_user",
      "vhost": "blockd",
      "configure": ".*",
      "write": ".*",
      "read": ".*"
    }
  ],
  "parameters": [],
  "global_parameters": [
    {
      "name": "cluster_name",
      "value": "blockd-rabbitmq-cluster"
    }
  ],
  "policies": [
    {
      "vhost": "blockd",
      "name": "ha-all",
      "pattern": ".*",
      "apply-to": "queues",
      "definition": {
        "ha-mode": "exactly",
        "ha-params": 2,
        "ha-sync-mode": "automatic",
        "queue-master-locator": "min-masters"
      },
      "priority": 0
    },
    {
      "vhost": "blockd",
      "name": "ttl-policy",
      "pattern": "^(video_|ai_|gaze_)",
      "apply-to": "queues",
      "definition": {
        "message-ttl": 86400000,
        "expires": 172800000
      },
      "priority": 1
    }
  ],
  "exchanges": [
    {
      "name": "video_processing",
      "vhost": "blockd",
      "type": "topic",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
    },
    {
      "name": "ai_detection",
      "vhost": "blockd",
      "type": "topic",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
    },
    {
      "name": "security_events",
      "vhost": "blockd",
      "type": "fanout",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
    },
    {
      "name": "gaze_analysis",
      "vhost": "blockd",
      "type": "topic",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
    },
    {
      "name": "dlx",
      "vhost": "blockd",
      "type": "topic",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
    }
  ],
  "queues": [
    {
      "name": "video_encode",
      "vhost": "blockd",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-queue-type": "quorum",
        "x-dead-letter-exchange": "dlx",
        "x-dead-letter-routing-key": "video_encode.dlq",
        "x-max-length": 100000,
        "x-overflow": "reject-publish"
      }
    },
    {
      "name": "video_thumbnail",
      "vhost": "blockd",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-queue-type": "quorum",
        "x-dead-letter-exchange": "dlx",
        "x-dead-letter-routing-key": "video_thumbnail.dlq",
        "x-max-length": 50000,
        "x-overflow": "reject-publish"
      }
    },
    {
      "name": "video_upload",
      "vhost": "blockd",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-queue-type": "quorum",
        "x-dead-letter-exchange": "dlx",
        "x-dead-letter-routing-key": "video_upload.dlq",
        "x-max-length": 50000,
        "x-overflow": "reject-publish"
      }
    },
    {
      "name": "ai_analyze",
      "vhost": "blockd",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-queue-type": "quorum",
        "x-dead-letter-exchange": "dlx",
        "x-dead-letter-routing-key": "ai_analyze.dlq",
        "x-max-length": 100000,
        "x-overflow": "reject-publish"
      }
    },
    {
      "name": "embedding_generate",
      "vhost": "blockd",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-queue-type": "quorum",
        "x-dead-letter-exchange": "dlx",
        "x-dead-letter-routing-key": "embedding_generate.dlq",
        "x-max-length": 50000,
        "x-overflow": "reject-publish"
      }
    },
    {
      "name": "cache_warmup",
      "vhost": "blockd",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-queue-type": "quorum",
        "x-dead-letter-exchange": "dlx",
        "x-dead-letter-routing-key": "cache_warmup.dlq",
        "x-max-length": 10000,
        "x-overflow": "drop-head"
      }
    },
    {
      "name": "security_alert",
      "vhost": "blockd",
      "durable": true,
      "auto_delete": false,
