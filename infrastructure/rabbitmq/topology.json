        "x-dead-letter-exchange": "dlx",
        "x-dead-letter-routing-key": "anomaly_detect.dlq",
        "x-max-length": 50000,
        "x-overflow": "reject-publish"
      }
    },
    {
      "name": "video_encode.dlq",
      "vhost": "blockd",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-queue-type": "quorum"
      }
    },
    {
      "name": "video_thumbnail.dlq",
      "vhost": "blockd",
