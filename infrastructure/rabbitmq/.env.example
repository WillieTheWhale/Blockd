# RabbitMQ Configuration
RABBITMQ_DEFAULT_USER=blockd_user
RABBITMQ_DEFAULT_PASS=blockd_password_change_in_production
RABBITMQ_DEFAULT_VHOST=blockd
RABBITMQ_ERLANG_COOKIE=blockd_cluster_cookie_change_in_production

# RabbitMQ Cluster
RABBITMQ_NODE1_PORT=5672
RABBITMQ_NODE2_PORT=5673
RABBITMQ_NODE3_PORT=5674
RABBITMQ_NODE1_MGMT_PORT=15672
RABBITMQ_NODE2_MGMT_PORT=15673
RABBITMQ_NODE3_MGMT_PORT=15674

# Redis Configuration
REDIS_PORT=6379
REDIS_MAXMEMORY=512mb

# Resource Limits
RABBITMQ_CPU_LIMIT=2
RABBITMQ_MEMORY_LIMIT=2g
REDIS_CPU_LIMIT=1
REDIS_MEMORY_LIMIT=512m

# Network
SUBNET=172.25.0.0/16
