# Test Environment Variables
# These variables are used during test execution

# Node Environment
NODE_ENV=test

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/blockd_test
REDIS_URL=redis://localhost:6379/1
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# API Configuration
API_BASE_URL=http://localhost:4000/api
WS_URL=ws://localhost:4001
FRONTEND_URL=http://localhost:3000

# JWT Configuration
JWT_SECRET=test_jwt_secret_key_for_testing_only
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_SECRET=test_refresh_token_secret_for_testing
REFRESH_TOKEN_EXPIRES_IN=7d

# External Services (Mock)
OPENAI_API_KEY=sk-test-mock-key
ANTHROPIC_API_KEY=sk-ant-test-mock-key
GOOGLE_AI_API_KEY=test-google-ai-key

# AWS S3 Configuration (Mock)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test-access-key
AWS_SECRET_ACCESS_KEY=test-secret-key
S3_BUCKET_NAME=blockd-test-recordings
S3_ENDPOINT=http://localhost:4566  # LocalStack

# Email Configuration (Mock)
SMTP_HOST=localhost
SMTP_PORT=1025  # MailHog
SMTP_USER=test
SMTP_PASS=test
EMAIL_FROM=noreply@test.blockd.io

# Rate Limiting (More lenient for tests)
RATE_LIMIT_MAX=1000
RATE_LIMIT_WINDOW_MS=60000

# Test-specific
TEST_TIMEOUT=30000
TEST_SLOW_THRESHOLD=5000
ENABLE_TEST_LOGGING=false
MOCK_EXTERNAL_SERVICES=true

# WebRTC Configuration
MEDIASOUP_LISTEN_IP=127.0.0.1
MEDIASOUP_ANNOUNCED_IP=127.0.0.1
MEDIASOUP_MIN_PORT=40000
MEDIASOUP_MAX_PORT=49999

# Monitoring (Disabled in tests)
SENTRY_DSN=
ENABLE_METRICS=false

# Feature Flags (for testing)
ENABLE_MFA=true
ENABLE_AI_DETECTION=true
ENABLE_GAZE_TRACKING=true
ENABLE_SCREEN_RECORDING=true
