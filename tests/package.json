{
  "name": "@blockd/tests",
  "version": "1.0.0",
  "description": "Comprehensive testing infrastructure for Blockd platform",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:ui": "vitest --ui",
    "test:unit:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:e2e:firefox": "playwright test --project=firefox",
    "test:e2e:webkit": "playwright test --project=webkit",
    "test:e2e:ui": "playwright test --ui",
    "test:api": "npm run test:api:auth && npm run test:api:sessions && npm run test:api:ai && npm run test:api:video",
    "test:api:auth": "newman run api/postman-collections/auth-api.postman_collection.json -e api/environments/local.json --reporters cli,html --reporter-html-export reports/newman/auth-api.html",
    "test:api:sessions": "newman run api/postman-collections/sessions-api.postman_collection.json -e api/environments/local.json --reporters cli,html --reporter-html-export reports/newman/sessions-api.html",
    "test:api:ai": "newman run api/postman-collections/ai-detection.postman_collection.json -e api/environments/local.json --reporters cli,html --reporter-html-export reports/newman/ai-detection.html",
    "test:api:video": "newman run api/postman-collections/video-api.postman_collection.json -e api/environments/local.json --reporters cli,html --reporter-html-export reports/newman/video-api.html",
    "test:integration": "npm run test:api",
    "test:load": "npm run test:load:normal",
    "test:load:normal": "k6 run load/normal-load.js",
    "test:load:peak": "k6 run load/peak-load.js",
    "test:load:stress": "k6 run load/stress-test.js",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:e2e && npm run test:load:normal",
    "db:seed": "tsx utils/seed.ts",
    "db:cleanup": "tsx utils/cleanup.ts",
    "db:reset": "npm run db:cleanup && npm run db:seed",
    "mock:ws": "tsx mocks/mock-websocket.ts",
    "mock:webrtc": "tsx mocks/mock-webrtc.ts",
    "mock:llm": "tsx mocks/mock-llm.ts",
    "playwright:install": "playwright install --with-deps",
    "reports:open": "open reports/index.html",
    "reports:coverage": "open reports/coverage/index.html",
    "reports:e2e": "open reports/playwright-report/index.html",
    "reports:api": "open reports/newman/index.html"
  },
  "keywords": [
    "testing",
    "e2e",
    "integration",
    "load-testing",
    "playwright",
    "newman",
    "k6",
    "vitest"
  ],
  "author": "Blockd Team",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^6.2.0",
    "bcrypt": "^5.1.1",
    "dotenv": "^16.4.7",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/bcrypt": "^5.0.2",
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "@vitest/coverage-v8": "^2.1.8",
    "@vitest/ui": "^2.1.8",
    "k6": "^0.0.0",
    "newman": "^6.2.1",
    "prisma": "^6.2.0",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
