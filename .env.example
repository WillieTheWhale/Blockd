# Blockd Platform Environment Variables
# Copy this file to .env and fill in the required values
#
# SECURITY WARNING: Never commit .env to version control!
# Required variables are marked with (REQUIRED)

# ============================================
# Database Configuration
# ============================================
POSTGRES_DB=blockd
POSTGRES_USER=blockd_user
POSTGRES_PASSWORD=                    # (REQUIRED) Strong password for PostgreSQL

# ============================================
# Redis Configuration
# ============================================
REDIS_PASSWORD=                       # (REQUIRED) Strong password for Redis

# ============================================
# RabbitMQ Configuration
# ============================================
RABBITMQ_USER=blockd_mq
RABBITMQ_PASSWORD=                    # (REQUIRED) Strong password for RabbitMQ
RABBITMQ_VHOST=blockd

# ============================================
# MinIO/S3 Configuration
# ============================================
MINIO_ROOT_USER=blockd_minio
MINIO_ROOT_PASSWORD=                  # (REQUIRED) Strong password for MinIO (min 8 chars)
S3_BUCKET=blockd-videos
S3_REGION=us-east-1

# ============================================
# Authentication & Security
# ============================================
JWT_SECRET=                           # (REQUIRED) Strong secret for JWT signing (min 32 chars)
JWT_EXPIRY=1h
REFRESH_TOKEN_EXPIRY=7d
MFA_ENCRYPTION_KEY=                   # (REQUIRED in production) 64-char hex string for MFA encryption

# ============================================
# AI/ML API Keys
# ============================================
OPENAI_API_KEY=                       # OpenAI API key for GPT-4
ANTHROPIC_API_KEY=                    # Anthropic API key for Claude

# ============================================
# Application Settings
# ============================================
NODE_ENV=development                  # development | staging | production

# ============================================
# Frontend URLs
# ============================================
VITE_API_URL=http://localhost:3000/api/v1
VITE_WS_URL=ws://localhost:3000

# ============================================
# GENERATING SECURE SECRETS
# ============================================
# Use these commands to generate secure secrets:
#
# For passwords (32 chars):
#   openssl rand -base64 32
#
# For JWT secret (64 chars):
#   openssl rand -hex 32
#
# For MFA encryption key (64 hex chars):
#   openssl rand -hex 32
#
# Example secure values for development only:
# POSTGRES_PASSWORD=dev_postgres_password_$(openssl rand -hex 8)
# REDIS_PASSWORD=dev_redis_password_$(openssl rand -hex 8)
# RABBITMQ_PASSWORD=dev_rabbitmq_password_$(openssl rand -hex 8)
# MINIO_ROOT_PASSWORD=dev_minio_password_$(openssl rand -hex 8)
# JWT_SECRET=$(openssl rand -hex 32)
# MFA_ENCRYPTION_KEY=$(openssl rand -hex 32)
