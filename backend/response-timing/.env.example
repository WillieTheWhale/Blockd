# Response Timing Service Configuration
# Copy to .env and update with your values

# Application
APP_NAME=Response Timing Service
APP_VERSION=1.0.0
DEBUG=false
ENVIRONMENT=production

# Server
HOST=0.0.0.0
PORT=8006
WORKERS=4

# Database
DATABASE_URL=postgresql://blockd_app:your_password@postgres:5432/blockd
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
RABBITMQ_EXCHANGE=blockd
RABBITMQ_QUEUE_TRANSCRIPTION=transcription_queue
RABBITMQ_QUEUE_ANALYSIS=timing_analysis_queue

# S3 Storage (MinIO or AWS S3)
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_AUDIO=blockd-audio
S3_REGION=us-east-1

# OpenAI Whisper
OPENAI_API_KEY=sk-your-openai-api-key-here
WHISPER_MODEL=whisper-1
WHISPER_MODE=api  # "api" for OpenAI API, "local" for self-hosted

# Local Whisper (if using WHISPER_MODE=local)
LOCAL_WHISPER_MODEL=base  # tiny, base, small, medium, large

# Audio Processing
AUDIO_SAMPLE_RATE=16000
AUDIO_MAX_SIZE_MB=25
AUDIO_FORMATS=["mp3", "wav", "m4a", "flac", "ogg", "webm"]

# Timing Analysis
SILENCE_THRESHOLD_DB=-40.0
MIN_SILENCE_DURATION=0.5
MIN_PAUSE_DURATION=0.3

# Expected Response Latencies (milliseconds)
EXPECTED_LATENCY_SIMPLE=3000
EXPECTED_LATENCY_ANALYTICAL=8000
EXPECTED_LATENCY_COMPLEX=15000

# Normal Speech Rate (WPM)
SPEECH_RATE_SLOW=80
SPEECH_RATE_NORMAL_MIN=120
SPEECH_RATE_NORMAL_MAX=160
SPEECH_RATE_FAST=200

# Anomaly Detection Thresholds
INSTANT_RESPONSE_THRESHOLD=0.5
UNNATURAL_CONSISTENCY_THRESHOLD=0.1
LOW_FILLER_THRESHOLD=0.01
HIGH_FILLER_THRESHOLD=0.15
PAUSE_PERCENTAGE_THRESHOLD=10.0

# Risk Scoring Weights
RISK_WEIGHT_INSTANT_RESPONSE=0.4
RISK_WEIGHT_UNNATURAL_CONSISTENCY=0.2
RISK_WEIGHT_DELAYED_FLUENT=0.3
RISK_WEIGHT_ROBOTIC_PATTERN=0.25
RISK_WEIGHT_LOW_FILLER=0.15
RISK_WEIGHT_HIGH_SPEED=0.2

# Performance
TRANSCRIPTION_TIMEOUT=300
ANALYSIS_TIMEOUT=60
MAX_CONCURRENT_JOBS=10

# Caching
REDIS_URL=redis://redis:6379/2
CACHE_TTL=3600

# Monitoring
LOG_LEVEL=INFO
LOG_FORMAT=json
SENTRY_DSN=
