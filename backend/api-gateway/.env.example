# Server Configuration
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Database Configuration
DATABASE_URL=postgresql://blockd_app:blockd_secure_password_2025@localhost:5432/blockd

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CLUSTER_ENABLED=false

# JWT Configuration
# Generate RSA key pair with:
# openssl genrsa -out private.key 2048
# openssl rsa -in private.key -pubout -out public.key
# Then replace \n with \\n in the keys
JWT_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END RSA PRIVATE KEY-----
JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\nYOUR_PUBLIC_KEY_HERE\n-----END PUBLIC KEY-----
JWT_ACCESS_TOKEN_EXPIRY=1h
JWT_REFRESH_TOKEN_EXPIRY=7d

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
CORS_CREDENTIALS=true

# Rate Limiting Configuration
RATE_LIMIT_PUBLIC_MAX=100
RATE_LIMIT_PUBLIC_WINDOW=60
RATE_LIMIT_AUTH_MAX=500
RATE_LIMIT_AUTH_WINDOW=60

# Logging Configuration
LOG_LEVEL=info
LOG_PRETTY_PRINT=true

# Service URLs (for proxying to other microservices)
AUTH_SERVICE_URL=http://localhost:3001
SESSION_SERVICE_URL=http://localhost:3002
AI_DETECTION_SERVICE_URL=http://localhost:3003
EYE_TRACKING_SERVICE_URL=http://localhost:3004

# Optional: Enable Swagger in production
ENABLE_SWAGGER=false
