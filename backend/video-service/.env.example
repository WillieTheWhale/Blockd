# Video Processing Service - Environment Configuration
# Copy this file to .env and configure with your values

# ===== Service Configuration =====
ENVIRONMENT=development
DEBUG=true
SERVICE_NAME=video-processing-service

# ===== API Configuration =====
API_HOST=0.0.0.0
API_PORT=8003

# ===== mediasoup Configuration =====
MEDIASOUP_HOST=localhost
MEDIASOUP_PORT=3000
MEDIASOUP_URL=http://localhost:3000

# WebRTC Port Range
RTC_MIN_PORT=10000
RTC_MAX_PORT=10100

# Public IP for WebRTC (set to your server's public IP)
ANNOUNCED_IP=127.0.0.1

# ===== FFmpeg Configuration =====
FFMPEG_PATH=/usr/bin/ffmpeg
RECORDING_PATH=/tmp/recordings
FFMPEG_LOG_LEVEL=error

# ===== S3 Storage Configuration =====
# For AWS S3
S3_ENDPOINT=
S3_ACCESS_KEY=your_access_key
S3_SECRET_KEY=your_secret_key
S3_BUCKET=blockd-recordings
S3_REGION=us-east-1
S3_USE_SSL=true

# For MinIO (local development)
# S3_ENDPOINT=http://localhost:9000
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# S3_BUCKET=blockd-recordings
# S3_REGION=us-east-1
# S3_USE_SSL=false

# For Cloudflare R2
# S3_ENDPOINT=https://your-account.r2.cloudflarestorage.com
# S3_ACCESS_KEY=your_r2_access_key
# S3_SECRET_KEY=your_r2_secret_key
# S3_BUCKET=blockd-recordings
# S3_REGION=auto
# S3_USE_SSL=true

# Signed URL expiry (seconds, default: 7 days)
SIGNED_URL_EXPIRY=604800

# ===== RabbitMQ Configuration =====
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

# ===== Database Configuration =====
DATABASE_URL=postgresql://blockd:blockd@localhost:5432/blockd

# ===== Redis Configuration =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ===== Performance Settings =====
MAX_CONCURRENT_STREAMS=100
MAX_RECORDING_DURATION=7200
RECORDING_BUFFER_SIZE=5000

# ===== Cleanup Settings =====
TEMP_FILE_RETENTION=3600
AUTO_CLEANUP_ENABLED=true

# ===== Monitoring =====
ENABLE_METRICS=true
METRICS_PORT=9090

# ===== CORS Settings =====
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080
