# Eye Tracking Service Environment Configuration

# Service Configuration
SERVICE_NAME=eye-tracking-service
VERSION=1.0.0
DEBUG=false

# Server Configuration
HOST=0.0.0.0
PORT=8006
WORKERS=4

# Database Configuration (TimescaleDB)
DATABASE_URL=postgresql://postgres:postgres@timescaledb:5432/blockd
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
DB_POOL_TIMEOUT=30

# RabbitMQ Configuration
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
GAZE_QUEUE_NAME=gaze_processing_queue
GAZE_EXCHANGE_NAME=gaze_events

# WebSocket Configuration
WEBSOCKET_URL=ws://websocket-service:8005
WEBSOCKET_PATH=/ws

# MediaPipe FaceMesh Configuration
MEDIAPIPE_MAX_NUM_FACES=1
MEDIAPIPE_REFINE_LANDMARKS=true
MEDIAPIPE_MIN_DETECTION_CONFIDENCE=0.5
MEDIAPIPE_MIN_TRACKING_CONFIDENCE=0.5
MEDIAPIPE_STATIC_IMAGE_MODE=false

# Gaze Estimation Configuration
GAZE_FRAME_WIDTH=1920
GAZE_FRAME_HEIGHT=1080
GAZE_FOCAL_LENGTH=1000.0
GAZE_CONFIDENCE_THRESHOLD=0.7

# Kalman Filter Configuration
KALMAN_PROCESS_NOISE=0.01
KALMAN_MEASUREMENT_NOISE=0.05
KALMAN_DT=0.033

# Pattern Recognition Configuration
READING_SACCADE_VELOCITY_THRESHOLD=500.0
READING_MIN_HORIZONTAL_SACCADES=10
READING_MIN_LINE_BREAKS=2
READING_TIME_WINDOW=5.0

ATTENTION_DRIFT_THRESHOLD=10.0
SHIFTY_EYES_DIRECTION_THRESHOLD=5
SHIFTY_EYES_TIME_WINDOW=30.0

# LSTM Anomaly Detection Configuration
LSTM_SEQUENCE_LENGTH=30
LSTM_FEATURES=2
LSTM_BATCH_SIZE=32
LSTM_EPOCHS=50
LSTM_ANOMALY_THRESHOLD=0.05
LSTM_MODEL_PATH=/app/models/lstm_autoencoder.h5

# Heatmap Configuration
HEATMAP_WIDTH=1920
HEATMAP_HEIGHT=1080
HEATMAP_GAUSSIAN_SIGMA=50
HEATMAP_KERNEL_SIZE=101
HEATMAP_OUTPUT_DIR=/app/data/heatmaps

# Performance Configuration
MAX_FPS=30
FRAME_PROCESSING_TIMEOUT=0.050
MAX_GAZE_BUFFER_SIZE=1000

# Risk Score Weights
RISK_OFFSCREEN_WEIGHT_SEVERE=0.3
RISK_OFFSCREEN_WEIGHT_MODERATE=0.1
RISK_READING_WEIGHT=0.4
RISK_DRIFT_WEIGHT=0.2
RISK_SHIFTY_WEIGHT=0.3
RISK_ANOMALY_WEIGHT_PER_EVENT=0.05
RISK_ANOMALY_MAX_WEIGHT=0.3

# Storage Configuration
GAZE_DATA_RETENTION_DAYS=90
SESSION_SUMMARY_CACHE_HOURS=24

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,https://blockd.io

# JWT Configuration
JWT_SECRET_KEY=change-this-in-production-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json
