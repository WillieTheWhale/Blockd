# Server Configuration
NODE_ENV=development
PORT=3002
HOST=0.0.0.0

# Database
DATABASE_URL=postgresql://blockd_user:blockd_password@localhost:5432/blockd

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=session:

# RabbitMQ
RABBITMQ_URL=amqp://blockd_user:blockd_password@localhost:5672
RABBITMQ_EXCHANGE_VIDEO=video_processing
RABBITMQ_EXCHANGE_AI=ai_detection
RABBITMQ_EXCHANGE_SECURITY=security_events
RABBITMQ_EXCHANGE_GAZE=gaze_analysis

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=24h

# Session Configuration
SESSION_TOKEN_LENGTH=64
SESSION_TOKEN_TTL=86400
MAX_SESSION_DURATION_HOURS=4

# WebSocket Configuration
WEBSOCKET_PORT=3003
WEBSOCKET_CORS_ORIGIN=http://localhost:3000
WEBSOCKET_PING_INTERVAL=25000
WEBSOCKET_PING_TIMEOUT=60000

# Frontend URLs
FRONTEND_URL=http://localhost:3000
SESSION_JOIN_URL_BASE=http://localhost:3000/session/join

# Email Service
EMAIL_SERVICE_URL=http://localhost:3005
EMAIL_FROM=noreply@blockd.site

# API Gateway
API_GATEWAY_URL=http://localhost:3001

# Risk Score Thresholds
RISK_THRESHOLD_LOW=0.50
RISK_THRESHOLD_MEDIUM=0.75
RISK_THRESHOLD_HIGH=0.90

# Report Generation
REPORT_GENERATION_ENABLED=true
REPORT_PDF_ENABLED=true
REPORT_STORAGE_PATH=/tmp/reports

# Logging
LOG_LEVEL=info
LOG_PRETTY_PRINT=true

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=60000

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090
