# AI Detection Service Environment Variables
# Copy this file to .env and configure with actual values

# Application
ENV=development
DEBUG=false
HOST=0.0.0.0
PORT=8005

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/blockd
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CLUSTER_ENABLED=false

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

# OpenAI API
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4-turbo-2024-04-09
OPENAI_MAX_TOKENS=500
OPENAI_TEMPERATURE=0.7

# Anthropic API
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_MAX_TOKENS=500

# Google Generative AI API
GOOGLE_API_KEY=your-google-api-key-here
GOOGLE_MODEL=gemini-1.5-pro

# ML Models
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
PERPLEXITY_MODEL=gpt2
XGBOOST_MODEL_PATH=/app/models/xgboost_classifier.json

# Cache Configuration
AI_ANSWER_CACHE_TTL=86400
ANALYSIS_CACHE_TTL=604800
CACHE_PREFIX=ai_detection

# Detection Thresholds
RISK_THRESHOLD_CRITICAL=0.90
RISK_THRESHOLD_HIGH=0.75
RISK_THRESHOLD_MEDIUM=0.50
RISK_THRESHOLD_LOW=0.30

# Similarity Thresholds
SIMILARITY_THRESHOLD_HIGH=0.85
PERPLEXITY_THRESHOLD_LOW=50.0
NGRAM_OVERLAP_THRESHOLD=0.70

# Performance Configuration
LLM_TIMEOUT=30
LLM_MAX_RETRIES=3
PARALLEL_LLM_CALLS=true

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
CORS_ALLOW_CREDENTIALS=true
