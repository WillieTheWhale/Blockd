{
  "name": "@blockd/websocket-service",
  "version": "1.0.0",
  "description": "Real-time WebSocket service for Blockd interview platform",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write \"**/*.{ts,json,md}\"",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "websocket",
    "socket.io",
    "real-time",
    "interview",
    "blockd"
  ],
  "author": "Blockd Team",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "socket.io": "^4.7.5",
    "@socket.io/redis-adapter": "^8.3.0",
    "redis": "^4.7.0",
    "jsonwebtoken": "^9.0.2",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "@prisma/client": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/express": "^4.17.21",
    "prisma": "^6.0.0",
    "typescript": "^5.9.3",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "@types/jest": "^29.5.14",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "socket.io-client": "^4.7.5",
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "typescript-eslint": "^8.18.2",
    "prettier": "^3.4.2"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
