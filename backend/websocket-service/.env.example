# WebSocket Service Configuration

# Server
NODE_ENV=development
PORT=3003
HOST=0.0.0.0

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_CREDENTIALS=true

# Socket.io
TRANSPORTS=websocket,polling
PING_INTERVAL=25000
PING_TIMEOUT=20000
MAX_HTTP_BUFFER_SIZE=1000000

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=blockd:ws

# JWT Authentication
JWT_PUBLIC_KEY_PATH=../auth-service/keys/public.pem
JWT_ALGORITHM=RS256
JWT_ISSUER=blockd-auth
JWT_AUDIENCE=blockd-api

# Rate Limiting
RATE_LIMIT_MAX_EVENTS=1000
RATE_LIMIT_CHECK_INTERVAL=1000

# Message Buffer
MESSAGE_BUFFER_MAX_SIZE=100
MESSAGE_BUFFER_MAX_AGE_MS=300000

# Reconnection
RECONNECT_MAX_ATTEMPTS=10
RECONNECT_INITIAL_DELAY=1000
RECONNECT_MAX_DELAY=30000

# Gaze Streaming
GAZE_THROTTLE_HZ=10

# Logging
LOG_LEVEL=debug
LOG_FORMAT=pretty
