# Blockd Authentication Service - Environment Configuration
# Copy this file to .env and fill in your values

# Server Configuration
NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/blockd

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT Configuration
# Keys are generated using: npm run keys:generate
# Keys are stored in the keys/ directory

# MFA Configuration
# Generate with: node scripts/generate-keys.js
MFA_ENCRYPTION_KEY=your_64_character_hex_key_here_generate_with_script

# OAuth Providers
# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/oauth/google/callback

# Microsoft OAuth
MICROSOFT_CLIENT_ID=your_microsoft_client_id
MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret
MICROSOFT_CALLBACK_URL=http://localhost:3001/auth/oauth/microsoft/callback

# Frontend URL
FRONTEND_URL=http://localhost:3000

# CORS
CORS_ORIGIN=http://localhost:3000

# Rate Limiting
RATE_LIMITING_ENABLED=true
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute

# Email Configuration (AWS SES)
# Set EMAIL_ENABLED=true to enable real email sending
EMAIL_ENABLED=false
EMAIL_FROM=noreply@blockd.io

# AWS Configuration for SES
# Required in production when EMAIL_ENABLED=true
# Can also use IAM roles in EKS/EC2 (recommended for production)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# Logging
LOG_LEVEL=info
