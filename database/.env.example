# Blockd Database Environment Variables
# Copy this file to .env and customize the values

# Database Connection
BLOCKD_DATABASE_URL=postgresql://blockd:password@localhost:5432/blockd_db

# Individual connection parameters (alternative to DATABASE_URL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=blockd_db
DB_USER=blockd
DB_PASSWORD=password

# Connection Pool Settings
DB_POOL_MIN=2
DB_POOL_MAX=20
DB_CONNECT_TIMEOUT=10

# Docker settings
POSTGRES_USER=blockd
POSTGRES_PASSWORD=password
POSTGRES_DB=blockd_db

# pgAdmin settings (optional)
PGADMIN_DEFAULT_EMAIL=admin@blockd.local
PGADMIN_DEFAULT_PASSWORD=admin

# Application settings
NODE_ENV=development
DEBUG=true
